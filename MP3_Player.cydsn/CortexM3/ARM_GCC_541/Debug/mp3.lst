 378:source\asw/mp3.c **** {
 379:source\asw/mp3.c ****     FS_DIR    * pDir;
 380:source\asw/mp3.c ****     FS_DIRENT * pDirEnt;
 381:source\asw/mp3.c ****     char        entryName[64];
 382:source\asw/mp3.c ****     char        logBuf[48];
