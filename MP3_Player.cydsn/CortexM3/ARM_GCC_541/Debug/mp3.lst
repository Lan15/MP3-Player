 206:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 207:source\asw/mp3.c ****             }
 208:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
