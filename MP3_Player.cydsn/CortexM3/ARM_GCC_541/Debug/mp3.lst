 103:source\asw/mp3.c **** /**
 104:source\asw/mp3.c ****  * The implementation of the MP3 Player State Machine
 105:source\asw/mp3.c ****  * /param EventMaskType nextEvent   : The event to be processed [IN]
 106:source\asw/mp3.c ****  * /return RC_SUCCESS
 107:source\asw/mp3.c ****  */
 108:source\asw/mp3.c **** RC_t MP3_ProcessEvent(EventMaskType nextEvent)
 109:source\asw/mp3.c **** {
 110:source\asw/mp3.c ****     //Debugging aid
 111:source\asw/mp3.c ****     //MP3__showEventAndState(nextEvent, MP3__player.m_state);
 112:source\asw/mp3.c ****     
 113:source\asw/mp3.c ****     switch (MP3__player.m_state)
 114:source\asw/mp3.c ****     {
 115:source\asw/mp3.c ****         case MP3STATE_ISSTOPPED :
 116:source\asw/mp3.c ****             if (nextEvent & ev_Button1)
 117:source\asw/mp3.c ****             {
 118:source\asw/mp3.c ****                 MP3__prevSong();
 119:source\asw/mp3.c ****                 MP3__showSong();
 120:source\asw/mp3.c ****             }
 121:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 122:source\asw/mp3.c ****             {
 123:source\asw/mp3.c ****                 MP3__nextSong();
 124:source\asw/mp3.c ****                 MP3__showSong();
 125:source\asw/mp3.c ****             }
 126:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 127:source\asw/mp3.c ****             {
 128:source\asw/mp3.c ****                 MP3__playSong();
 129:source\asw/mp3.c ****                 MP3__showSong();
 130:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 131:source\asw/mp3.c ****             }
 132:source\asw/mp3.c ****             break;
 133:source\asw/mp3.c **** 
 134:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 135:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 136:source\asw/mp3.c ****             {
 137:source\asw/mp3.c ****                 MP3__increaseVolume();
 138:source\asw/mp3.c ****             }
 139:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 140:source\asw/mp3.c ****             {
 141:source\asw/mp3.c ****                 MP3__decreaseVolume();
 142:source\asw/mp3.c ****             }
 143:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 144:source\asw/mp3.c ****             {
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc5AcxHC.s 			page 4


 145:source\asw/mp3.c ****                 MP3__pauseSong();
 146:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
 147:source\asw/mp3.c ****             }
 148:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 149:source\asw/mp3.c ****             {
 150:source\asw/mp3.c ****                 MP3__stopSong();
 151:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 152:source\asw/mp3.c ****             }
 153:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
 154:source\asw/mp3.c ****             {
 155:source\asw/mp3.c ****                 MP3__showRemainingPlaytime();
 156:source\asw/mp3.c ****             }
 157:source\asw/mp3.c ****             else if (nextEvent & ev_1s && MP3__songEnded())
 158:source\asw/mp3.c ****             {
 159:source\asw/mp3.c ****                 MP3__nextSong(); 
 160:source\asw/mp3.c ****                 MP3__playSong();
 161:source\asw/mp3.c ****                 MP3__showSong();
 162:source\asw/mp3.c ****             }
 163:source\asw/mp3.c ****             break;
 164:source\asw/mp3.c ****             
 165:source\asw/mp3.c ****         case MP3STATE_ISPAUSING :
 166:source\asw/mp3.c ****             if (nextEvent & ev_Button3)
 167:source\asw/mp3.c ****             {
 168:source\asw/mp3.c ****                 MP3__resumeSong();
 169:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 170:source\asw/mp3.c ****             }
 171:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 172:source\asw/mp3.c ****             {
 173:source\asw/mp3.c ****                 MP3__stopSong();
 174:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 175:source\asw/mp3.c ****             }
 176:source\asw/mp3.c **** 
 177:source\asw/mp3.c ****             break;
 178:source\asw/mp3.c ****     }
 179:source\asw/mp3.c ****     return RC_SUCCESS;
 180:source\asw/mp3.c **** }
