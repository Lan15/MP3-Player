 818:source\asw/mp3.c **** /**
 819:source\asw/mp3.c ****  * \brief Read one block of PCM, convert it and fill the inactive sound buffer.
 820:source\asw/mp3.c ****  *
 821:source\asw/mp3.c ****  * The DBG pins show the time of the three steps on the oscilloscope:
 822:source\asw/mp3.c ****  * DBG_FS = FS_Read(), DBG_CONV = conversion, DBG_FILL = SOUND_FillBuffer(),
 823:source\asw/mp3.c ****  * DBG_DEAD = from the buffer swap in the ISR until this function is done.
 824:source\asw/mp3.c ****  *
 825:source\asw/mp3.c ****  *   Format         block_align  raw bytes per 1024 output samples
 826:source\asw/mp3.c ****  *   8-bit  mono         1          1024   (no conversion)
 827:source\asw/mp3.c ****  *   16-bit mono         2          2048
 828:source\asw/mp3.c ****  *   24-bit mono         3          3072
 829:source\asw/mp3.c ****  *   stereo           2 x mono   2 x mono   (L+R averaged, N3)
 830:source\asw/mp3.c ****  *   44100 Hz           2 x      (2 frames averaged, N4)
 831:source\asw/mp3.c ****  *
 832:source\asw/mp3.c ****  * Read errors force the EOF: MP3__bytesRemaining is set to 0.
 833:source\asw/mp3.c ****  */
 834:source\asw/mp3.c **** static void MP3__readBlock(void)
 835:source\asw/mp3.c **** {
 836:source\asw/mp3.c ****     uint16_t const blockAlign = MP3__wavInfo.header.block_align;                     /* bytes per i
 837:source\asw/mp3.c ****     uint8_t  const step       = (uint8_t)(MP3__wavInfo.header.sample_rate / MP3__OUTPUT_RATE); /* 1
 838:source\asw/mp3.c ****     uint16_t const inBytes    = (uint16_t)(blockAlign * step);                       /* input bytes
 839:source\asw/mp3.c ****     uint32_t maxBytes         = (uint32_t)SOUND_BUFFER_SIZE * inBytes;
 840:source\asw/mp3.c ****     uint32_t toRead;
 841:source\asw/mp3.c ****     U32      bytesRead;
 842:source\asw/mp3.c ****     uint32_t total;
 843:source\asw/mp3.c ****     uint16_t samples;
 844:source\asw/mp3.c **** 
 845:source\asw/mp3.c ****     /* INC 6A: never read more than the buffer can hold */
 846:source\asw/mp3.c ****     if (maxBytes > MP3__MAX_READ)
 847:source\asw/mp3.c ****     {
 848:source\asw/mp3.c ****         maxBytes = MP3__MAX_READ;
 849:source\asw/mp3.c ****     }
 850:source\asw/mp3.c ****     /* INC 6D: read whole output samples only */
 851:source\asw/mp3.c ****     maxBytes -= (maxBytes % inBytes);
 852:source\asw/mp3.c **** 
 853:source\asw/mp3.c ****     /* INC 8 / N5: the first read stops on a sector boundary, all later reads
 854:source\asw/mp3.c ****        are maxBytes (a multiple of 512 for the usual formats) */
 855:source\asw/mp3.c ****     if (MP3__alignBytes != 0u)
 856:source\asw/mp3.c ****     {
 857:source\asw/mp3.c ****         toRead          = MP3__alignBytes;
 858:source\asw/mp3.c ****         MP3__alignBytes = 0u;
 859:source\asw/mp3.c ****     }
 860:source\asw/mp3.c ****     else
 861:source\asw/mp3.c ****     {
 862:source\asw/mp3.c ****         toRead = maxBytes;
 863:source\asw/mp3.c ****     }
 864:source\asw/mp3.c ****     if (toRead > MP3__bytesRemaining)
 865:source\asw/mp3.c ****     {
 866:source\asw/mp3.c ****         toRead = MP3__bytesRemaining;
 867:source\asw/mp3.c ****     }
 868:source\asw/mp3.c **** 
