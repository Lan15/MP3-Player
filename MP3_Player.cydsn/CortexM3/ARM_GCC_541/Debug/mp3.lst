 156:source\asw/mp3.c **** /**
 157:source\asw/mp3.c ****  * The implementation of the MP3 Player State Machine
 158:source\asw/mp3.c ****  * /param EventMaskType nextEvent   : The event to be processed [IN]
 159:source\asw/mp3.c ****  * /return RC_SUCCESS
 160:source\asw/mp3.c ****  */
 161:source\asw/mp3.c **** RC_t MP3_ProcessEvent(EventMaskType nextEvent)
 162:source\asw/mp3.c **** {
 163:source\asw/mp3.c ****     //Debugging aid
 164:source\asw/mp3.c ****     //MP3__showEventAndState(nextEvent, MP3__player.m_state);
 165:source\asw/mp3.c ****     
 166:source\asw/mp3.c ****     switch (MP3__player.m_state)
 167:source\asw/mp3.c ****     {
 168:source\asw/mp3.c ****         case MP3STATE_ISSTOPPED :
 169:source\asw/mp3.c ****             if (nextEvent & ev_Button1)
 170:source\asw/mp3.c ****             {
 171:source\asw/mp3.c ****                 MP3__prevSong();
 172:source\asw/mp3.c ****                 MP3__showSong();
 173:source\asw/mp3.c ****             }
 174:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 175:source\asw/mp3.c ****             {
 176:source\asw/mp3.c ****                 MP3__nextSong();
 177:source\asw/mp3.c ****                 MP3__showSong();
 178:source\asw/mp3.c ****             }
 179:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 180:source\asw/mp3.c ****             {
 181:source\asw/mp3.c ****                 MP3__playSong();
 182:source\asw/mp3.c ****                 MP3__showSong();
 183:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 184:source\asw/mp3.c ****             }
 185:source\asw/mp3.c ****             break;
 186:source\asw/mp3.c **** 
 187:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 188:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 189:source\asw/mp3.c ****             {
 190:source\asw/mp3.c ****                 MP3__increaseVolume();
 191:source\asw/mp3.c ****             }
 192:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 193:source\asw/mp3.c ****             {
 194:source\asw/mp3.c ****                 MP3__decreaseVolume();
 195:source\asw/mp3.c ****             }
 196:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 197:source\asw/mp3.c ****             {
 198:source\asw/mp3.c ****                 MP3__pauseSong();
 199:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
 200:source\asw/mp3.c ****             }
 201:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 202:source\asw/mp3.c ****             {
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccbuVoda.s 			page 5


 203:source\asw/mp3.c ****                 MP3__stopSong();
 204:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 205:source\asw/mp3.c ****             }
 206:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
 207:source\asw/mp3.c ****             {
 208:source\asw/mp3.c ****                 MP3__showRemainingPlaytime();
 209:source\asw/mp3.c ****             }
 210:source\asw/mp3.c ****             else if (nextEvent & ev_1s && MP3__songEnded())
 211:source\asw/mp3.c ****             {
 212:source\asw/mp3.c ****                 MP3__nextSong(); 
 213:source\asw/mp3.c ****                 MP3__playSong();
 214:source\asw/mp3.c ****                 MP3__showSong();
 215:source\asw/mp3.c ****             }
 216:source\asw/mp3.c ****             break;
 217:source\asw/mp3.c ****             
 218:source\asw/mp3.c ****         case MP3STATE_ISPAUSING :
 219:source\asw/mp3.c ****             if (nextEvent & ev_Button3)
 220:source\asw/mp3.c ****             {
 221:source\asw/mp3.c ****                 MP3__resumeSong();
 222:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 223:source\asw/mp3.c ****             }
 224:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 225:source\asw/mp3.c ****             {
 226:source\asw/mp3.c ****                 MP3__stopSong();
 227:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 228:source\asw/mp3.c ****             }
 229:source\asw/mp3.c **** 
 230:source\asw/mp3.c ****             break;
 231:source\asw/mp3.c ****     }
 232:source\asw/mp3.c ****     return RC_SUCCESS;
 233:source\asw/mp3.c **** }
