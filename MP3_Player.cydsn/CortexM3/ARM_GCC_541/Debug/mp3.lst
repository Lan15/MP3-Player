 267:source\asw/mp3.c ****             }
 268:source\asw/mp3.c ****  
 269:source\asw/mp3.c ****             /* Set remaining play time from WAV header */
 270:source\asw/mp3.c ****             MP3__player.m_remainingPlayTime =
 271:source\asw/mp3.c ****                 (uint16_t)(MP3__wavInfo.data_length
 272:source\asw/mp3.c ****                             / MP3__wavInfo.header.sample_rate);
 273:source\asw/mp3.c ****             SEVEN_Set(SEVEN_0, MP3__player.m_remainingPlayTime);
 274:source\asw/mp3.c ****  
 275:source\asw/mp3.c ****             /* Pre-fill Buffer A - becomes active */
 276:source\asw/mp3.c ****             fillSize = (MP3__bytesRemaining >= SOUND_BUFFER_SIZE)
 277:source\asw/mp3.c ****                         ? SOUND_BUFFER_SIZE
 278:source\asw/mp3.c ****                         : (uint16_t)MP3__bytesRemaining;
 279:source\asw/mp3.c ****  
 280:source\asw/mp3.c ****             bytesRead = FS_Read(MP3__pFile, MP3__readBuf, fillSize);
 281:source\asw/mp3.c ****             MP3__bytesRemaining -= (uint32_t)bytesRead;
 282:source\asw/mp3.c ****             SOUND_FillBuffer(MP3__readBuf, (uint16_t)bytesRead);
 283:source\asw/mp3.c ****             SOUND_SwapBuffers();
 284:source\asw/mp3.c ****  
 285:source\asw/mp3.c ****             /* Pre-fill Buffer B - inactive, ready for first swap */
 286:source\asw/mp3.c ****             if (MP3__bytesRemaining > 0u)
 287:source\asw/mp3.c ****             {
 288:source\asw/mp3.c ****                 fillSize = (MP3__bytesRemaining >= SOUND_BUFFER_SIZE)
 289:source\asw/mp3.c ****                             ? SOUND_BUFFER_SIZE
 290:source\asw/mp3.c ****                             : (uint16_t)MP3__bytesRemaining;
 291:source\asw/mp3.c ****  
 292:source\asw/mp3.c ****                 bytesRead = FS_Read(MP3__pFile, MP3__readBuf, fillSize);
 293:source\asw/mp3.c ****                 MP3__bytesRemaining -= (uint32_t)bytesRead;
 294:source\asw/mp3.c ****                 SOUND_FillBuffer(MP3__readBuf, (uint16_t)bytesRead);
 295:source\asw/mp3.c ****             }
 296:source\asw/mp3.c ****  
 297:source\asw/mp3.c ****             SOUND_StartPlay();
 298:source\asw/mp3.c ****  
 299:source\asw/mp3.c ****             //sprintf(logBuf, "\r\n[MP3] Playing. %lu bytes left\n", MP3__bytesRemaining);
