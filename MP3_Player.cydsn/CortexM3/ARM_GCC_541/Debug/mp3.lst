 394:source\asw/mp3.c ****             strncpy(MP3__songList[i], SOUND_Records[i].m_title,
 395:source\asw/mp3.c ****                     MP3_FILENAME_MAXLEN - 1u);
 396:source\asw/mp3.c ****     }
 397:source\asw/mp3.c ****     else
