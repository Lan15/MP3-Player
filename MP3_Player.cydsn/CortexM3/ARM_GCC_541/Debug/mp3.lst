 324:source\asw/mp3.c ****                     MP3__player.m_state = MP3STATE_ISSTOPPED;
 325:source\asw/mp3.c ****                     break;
 326:source\asw/mp3.c ****                 }
 327:source\asw/mp3.c ****  
 328:source\asw/mp3.c ****                 /* Set remaining play time from WAV header */
 329:source\asw/mp3.c ****                 MP3__player.m_remainingPlayTime =
