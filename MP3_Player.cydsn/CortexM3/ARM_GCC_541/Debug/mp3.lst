 235:source\asw/mp3.c **** void MP3_Reader()
 236:source\asw/mp3.c **** {
 237:source\asw/mp3.c ****     //char     logBuf[48];
 238:source\asw/mp3.c **** 
 239:source\asw/mp3.c ****     switch (MP3__reader.m_state)
 240:source\asw/mp3.c ****     {
 241:source\asw/mp3.c ****         case MP3READER_IDLE:
 242:source\asw/mp3.c ****         {
 243:source\asw/mp3.c ****             /* INC 5E: the only place a new song request is accepted */
 244:source\asw/mp3.c ****             if (MP3__reader.m_newSongRequest == FALSE)
 245:source\asw/mp3.c ****             {
 246:source\asw/mp3.c ****                 break;
 247:source\asw/mp3.c ****             }
 248:source\asw/mp3.c ****             MP3__reader.m_newSongRequest = FALSE;
 249:source\asw/mp3.c ****             MP3__reader.m_state          = MP3READER_OPEN;
 250:source\asw/mp3.c ****             /* fall through - open the new song with the same event */
 251:source\asw/mp3.c ****         }
 252:source\asw/mp3.c **** 
 253:source\asw/mp3.c ****         case MP3READER_OPEN:
 254:source\asw/mp3.c ****         {
 255:source\asw/mp3.c ****             //UART_LOG_PutString("\r\n[MP3] Open: ");                     // INC 5E
 256:source\asw/mp3.c ****             //UART_LOG_PutString(MP3__songList[MP3__reader.m_songIndex]);
