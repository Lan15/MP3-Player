 163:source\asw/mp3.c ****     /* Scan SD card for WAV files */
 164:source\asw/mp3.c ****     UART_LOG_PutString("\r\n[MP3] Scanning SD card...\n");
 165:source\asw/mp3.c ****     
 166:source\asw/mp3.c ****     FS_Init(); 
 167:source\asw/mp3.c ****     
 168:source\asw/mp3.c ****     pDir = FS_OpenDir(MP3__SD_ROOT);
 169:source\asw/mp3.c ****     if (pDir == 0)
 170:source\asw/mp3.c ****     {
 171:source\asw/mp3.c ****         UART_LOG_PutString("\r\n[MP3] ERROR: cannot open root dir\n");
 172:source\asw/mp3.c ****         /* Fall back to flash songs */
 173:source\asw/mp3.c ****         MP3__player.m_noSongs = SOUND_NoOfRecords;
 174:source\asw/mp3.c ****         uint16_t i;
 175:source\asw/mp3.c ****         for (i = 0u; i < SOUND_NoOfRecords && i < MP3_MAX_SONGS; i++)
 176:source\asw/mp3.c ****             strncpy(MP3__songList[i], SOUND_Records[i].m_title,
 177:source\asw/mp3.c ****                     MP3_FILENAME_MAXLEN - 1u);
 178:source\asw/mp3.c ****     }
 179:source\asw/mp3.c ****     else
 180:source\asw/mp3.c ****     {
 181:source\asw/mp3.c ****         while (songCount < MP3_MAX_SONGS)
 182:source\asw/mp3.c ****         {
 183:source\asw/mp3.c ****             pDirEnt = FS_ReadDir(pDir);
 184:source\asw/mp3.c ****             if (pDirEnt == 0) break;
 185:source\asw/mp3.c ****  
 186:source\asw/mp3.c ****             FS_DirEnt2Name(pDirEnt, entryName);
 187:source\asw/mp3.c ****             FS_DirEnt2Attr(pDirEnt, &attr);
 188:source\asw/mp3.c ****  
 189:source\asw/mp3.c ****             if (attr & FS_ATTR_DIRECTORY) continue;
 190:source\asw/mp3.c ****  
 191:source\asw/mp3.c ****             if (strstr(entryName, ".WAV") != 0 ||
 192:source\asw/mp3.c ****                 strstr(entryName, ".wav") != 0)
 193:source\asw/mp3.c ****             {
 194:source\asw/mp3.c ****                 strncpy(MP3__songList[songCount], entryName,
 195:source\asw/mp3.c ****                         MP3_FILENAME_MAXLEN - 1u);
 196:source\asw/mp3.c ****                 MP3__songList[songCount][MP3_FILENAME_MAXLEN - 1u] = '\0';
 197:source\asw/mp3.c ****                 songCount++;
 198:source\asw/mp3.c ****  
 199:source\asw/mp3.c ****                 sprintf(logBuf, "\r\n[MP3] Found: %s\n", entryName);
 200:source\asw/mp3.c ****                 UART_LOG_PutString(logBuf);
 201:source\asw/mp3.c ****             }
 202:source\asw/mp3.c ****         }
