 199:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 200:source\asw/mp3.c ****             {
 201:source\asw/mp3.c ****                 MP3__pauseSong();
 202:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccSGWXKl.s 			page 5


 203:source\asw/mp3.c ****             }
 204:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 205:source\asw/mp3.c ****             {
 206:source\asw/mp3.c ****                 MP3__stopSong();
 207:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 208:source\asw/mp3.c ****             }
 209:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
