 236:source\asw/mp3.c **** /**
 237:source\asw/mp3.c ****  * \brief Initialise the player: scan the SD card, set the start volume, draw the TFT header.
 238:source\asw/mp3.c ****  *
 239:source\asw/mp3.c ****  * Resets player and reader to STOPPED / IDLE with the first song selected, calls
 240:source\asw/mp3.c ****  * FS_Init() and scans the card from the root (MP3__scanSD, N6). A scan problem
 241:source\asw/mp3.c ****  * sets the error flag (N8). Writes "No WAV files found" once if nothing was found.
 242:source\asw/mp3.c ****  *
 243:source\asw/mp3.c ****  * \return RC_SUCCESS always; problems are shown via UART and TFT
 244:source\asw/mp3.c ****  * \note   Call once from tsk_init after TFT_init() and SOUND_Init().
 245:source\asw/mp3.c ****  */
 246:source\asw/mp3.c **** RC_t MP3_Init(void)
 247:source\asw/mp3.c **** {
 248:source\asw/mp3.c ****     MP3__player.m_state       = MP3STATE_ISSTOPPED;
 249:source\asw/mp3.c ****     MP3__player.m_volume      = MP3__MAXVOLUME;
 250:source\asw/mp3.c ****     MP3__player.m_currentSong = 0u;
 251:source\asw/mp3.c ****     MP3__player.m_noSongs     = 0u;
 252:source\asw/mp3.c **** 
 253:source\asw/mp3.c ****     MP3__reader.m_state          = MP3READER_IDLE;
 254:source\asw/mp3.c ****     MP3__reader.m_newSongRequest = FALSE;
 255:source\asw/mp3.c **** 
 256:source\asw/mp3.c ****     /* Scan SD card for WAV files */
 257:source\asw/mp3.c ****     UART_LOG_PutString("\r\n[MP3] Scanning SD card...\r\n");
 258:source\asw/mp3.c **** 
 259:source\asw/mp3.c ****     FS_Init();
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccTNL8qc.s 			page 6


 260:source\asw/mp3.c ****     MP3__scanSD();                                  /* INC 9: scan from the root, subfolders includ
 261:source\asw/mp3.c **** 
 262:source\asw/mp3.c ****     /* Reported once here, not at the end of every folder (N6). An error
 263:source\asw/mp3.c ****        was already reported by the scan itself. */
 264:source\asw/mp3.c ****     if ((MP3__player.m_noSongs == 0u) && (MP3__error == FALSE))
 265:source\asw/mp3.c ****     {
