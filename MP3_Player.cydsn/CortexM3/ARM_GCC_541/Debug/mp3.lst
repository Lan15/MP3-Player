 394:source\asw/mp3.c **** /**
 395:source\asw/mp3.c ****  * \brief Run the reader state machine one step (tsk_reader, once per ev_BufEmpty).
 396:source\asw/mp3.c ****  *
 397:source\asw/mp3.c ****  * IDLE accepts a song request, OPEN opens the file and starts the sound,
 398:source\asw/mp3.c ****  * STREAMING refills the inactive buffer, EOF stops and closes (N7). Like the player
 399:source\asw/mp3.c ****  * state machine, all actions and state changes are written out in the switch.
 400:source\asw/mp3.c ****  * The function returns after one step; the WaitEvent() loop is in main.c.
 401:source\asw/mp3.c ****  *
 402:source\asw/mp3.c ****  * \note Call only from TASK(tsk_reader).
 403:source\asw/mp3.c ****  */
 404:source\asw/mp3.c **** void MP3_Reader(void)
 405:source\asw/mp3.c **** {
 406:source\asw/mp3.c ****     switch (MP3__reader.m_state)
 407:source\asw/mp3.c ****     {
 408:source\asw/mp3.c ****         case MP3READER_IDLE:
 409:source\asw/mp3.c ****         {
 410:source\asw/mp3.c ****             /* INC 5E: the only place a new song request is accepted */
 411:source\asw/mp3.c ****             if (MP3__reader.m_newSongRequest == FALSE)
 412:source\asw/mp3.c ****             {
 413:source\asw/mp3.c ****                 break;
 414:source\asw/mp3.c ****             }
 415:source\asw/mp3.c ****             MP3__reader.m_newSongRequest = FALSE;
 416:source\asw/mp3.c ****             MP3__reader.m_state          = MP3READER_OPEN;
 417:source\asw/mp3.c ****             /* fall through - open the new song with the same event (N10, Rule 16.3) */
 418:source\asw/mp3.c ****         }
 419:source\asw/mp3.c **** 
 420:source\asw/mp3.c ****         case MP3READER_OPEN:
 421:source\asw/mp3.c ****         {
 422:source\asw/mp3.c ****             if (MP3__openWavFile(MP3__reader.m_songIndex) != RC_SUCCESS)
 423:source\asw/mp3.c ****             {
 424:source\asw/mp3.c ****                 MP3__reader.m_failCount = (uint16_t)(MP3__reader.m_failCount + 1u);     /* INC 7 */
 425:source\asw/mp3.c ****                 MP3__reader.m_state     = MP3READER_IDLE;
 426:source\asw/mp3.c ****                 /* INC 7: player stays PLAYING. MP3__songEnded() is now true, so the
 427:source\asw/mp3.c ****                    next ev_1s in tsk_control moves on to the next song. */
 428:source\asw/mp3.c ****             }
 429:source\asw/mp3.c ****             else
 430:source\asw/mp3.c ****             {
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccTNL8qc.s 			page 9


