 318:source\asw/mp3.c ****             /* ---------------------------------------------------------- */
 319:source\asw/mp3.c ****             case MP3READER_OPEN:
 320:source\asw/mp3.c ****             {
 321:source\asw/mp3.c ****                 if (MP3__OpenWavFile(MP3__reader.m_songIndex) != RC_SUCCESS)
 322:source\asw/mp3.c ****                 {
