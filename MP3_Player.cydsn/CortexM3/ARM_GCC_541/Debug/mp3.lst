 173:source\asw/mp3.c ****                 UART_LOG_PutString("1");
 174:source\asw/mp3.c ****             }
 175:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 176:source\asw/mp3.c ****             {
 177:source\asw/mp3.c ****                 MP3__nextSong();
 178:source\asw/mp3.c ****                 MP3__showSong();
 179:source\asw/mp3.c ****                 UART_LOG_PutString("2");
 180:source\asw/mp3.c ****             }
 181:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 182:source\asw/mp3.c ****             {
 183:source\asw/mp3.c ****                 MP3__playSong();
 184:source\asw/mp3.c ****                 MP3__showSong();
 185:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 186:source\asw/mp3.c ****                 UART_LOG_PutString("3");
 187:source\asw/mp3.c ****             }
 188:source\asw/mp3.c ****             break;
 189:source\asw/mp3.c **** 
 190:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 191:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 192:source\asw/mp3.c ****             {
 193:source\asw/mp3.c ****                 MP3__increaseVolume();
 194:source\asw/mp3.c ****             }
 195:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 196:source\asw/mp3.c ****             {
 197:source\asw/mp3.c ****                 MP3__decreaseVolume();
