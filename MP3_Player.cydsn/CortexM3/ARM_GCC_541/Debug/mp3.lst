 384:source\asw/mp3.c ****     uint16_t    songCount = 0;
 385:source\asw/mp3.c ****     
 386:source\asw/mp3.c ****     pDir = FS_OpenDir(MP3__SD_ROOT);
 387:source\asw/mp3.c ****     if (pDir == 0)
