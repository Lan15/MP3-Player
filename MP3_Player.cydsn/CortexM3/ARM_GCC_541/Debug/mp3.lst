 582:source\asw/mp3.c **** /* INC 10B — partial refresh: touch the TFT only when something changed.
 583:source\asw/mp3.c ****  *   - nothing changed           -> no TFT access at all
 584:source\asw/mp3.c ****  *   - selection moved           -> redraw the old row and the new row (2 rows)
 585:source\asw/mp3.c ****  *   - first call / list changed -> redraw all rows once
 586:source\asw/mp3.c ****  * The header is drawn once by MP3__initDisplay() and is never touched here. */
 587:source\asw/mp3.c **** void MP3__showSong()
 588:source\asw/mp3.c **** {
 589:source\asw/mp3.c ****     uint16_t cur = MP3__player.m_currentSong;   /* snapshot once: a button press mid-call */
 590:source\asw/mp3.c ****     uint16_t no  = MP3__player.m_noSongs;       /* is picked up by the next cycle         */
 591:source\asw/mp3.c ****     uint16_t i;
 592:source\asw/mp3.c **** 
 593:source\asw/mp3.c ****     if (no != MP3__dispCount)
 594:source\asw/mp3.c ****     {
 595:source\asw/mp3.c ****         /* First call after init (or list changed): draw every row once */
 596:source\asw/mp3.c ****         for (i = 0u; i < no; i++)
 597:source\asw/mp3.c ****         {
 598:source\asw/mp3.c ****             MP3__drawRow(i, cur);
 599:source\asw/mp3.c ****         }
 600:source\asw/mp3.c ****         /* List got shorter: blank the rows that no longer exist */
 601:source\asw/mp3.c ****         if (MP3__dispCount != MP3__DISP_NONE)
 602:source\asw/mp3.c ****         {
 603:source\asw/mp3.c ****             for (i = no; i < MP3__dispCount; i++)
 604:source\asw/mp3.c ****             {
 605:source\asw/mp3.c ****                 TFT_fillRect(0, 18 + i * 12, CFG_TFT_WIDTH, 11, BLACK);
 606:source\asw/mp3.c ****             }
 607:source\asw/mp3.c ****         }
 608:source\asw/mp3.c ****         MP3__dispCount = no;
 609:source\asw/mp3.c ****         MP3__dispSong  = cur;
 610:source\asw/mp3.c ****     }
 611:source\asw/mp3.c ****     else if (cur != MP3__dispSong)
 612:source\asw/mp3.c ****     {
 613:source\asw/mp3.c ****         /* Selection moved: only the old and the new row change */
 614:source\asw/mp3.c ****         if (MP3__dispSong < no) { MP3__drawRow(MP3__dispSong, cur); }   /* old row -> unselected */
 615:source\asw/mp3.c ****         if (cur           < no) { MP3__drawRow(cur,           cur); }   /* new row -> selected   */
 616:source\asw/mp3.c ****         MP3__dispSong = cur;
 617:source\asw/mp3.c ****     }
 618:source\asw/mp3.c ****     /* else: identical to what is on the screen -> do nothing */
 619:source\asw/mp3.c **** }
