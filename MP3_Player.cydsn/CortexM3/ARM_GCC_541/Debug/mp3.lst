 304:source\asw/mp3.c **** 
 305:source\asw/mp3.c ****         case MP3READER_STREAMING:
 306:source\asw/mp3.c ****         {
 307:source\asw/mp3.c ****             /* INC 5E: new song request - leave current song, let IDLE handle it */
 308:source\asw/mp3.c ****             if (MP3__reader.m_newSongRequest == TRUE)
 309:source\asw/mp3.c ****             {
 310:source\asw/mp3.c ****                 SOUND_StopPlay();
 311:source\asw/mp3.c ****                 MP3__CloseWavFile();
 312:source\asw/mp3.c ****                 MP3__reader.m_state = MP3READER_IDLE;
 313:source\asw/mp3.c ****                 SetEvent(tsk_reader, ev_BufEmpty);  /* re-run reader now, IDLE opens new song */
 314:source\asw/mp3.c ****                 break;
 315:source\asw/mp3.c ****             }
 316:source\asw/mp3.c **** 
