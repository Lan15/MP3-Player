 286:source\asw/mp3.c ****                     sprintf(logBuf, "%02X ", MP3__readBuf[k]);
 287:source\asw/mp3.c ****                     UART_LOG_PutString(logBuf);
 288:source\asw/mp3.c ****                 }
 289:source\asw/mp3.c ****                 UART_LOG_PutString("\n");
 290:source\asw/mp3.c ****             }*/
 291:source\asw/mp3.c ****             SOUND_SwapBuffers();
 292:source\asw/mp3.c **** 
 293:source\asw/mp3.c ****             /* Pre-fill Buffer B - inactive, ready for first swap */
 294:source\asw/mp3.c ****             if (MP3__bytesRemaining > 0u)
 295:source\asw/mp3.c ****             {
 296:source\asw/mp3.c ****                 MP3__ReadBlock();
