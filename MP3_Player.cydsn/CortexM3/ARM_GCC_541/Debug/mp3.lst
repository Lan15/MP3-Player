 217:source\asw/mp3.c **** /**
 218:source\asw/mp3.c ****  * The implementation of the MP3 Player State Machine
 219:source\asw/mp3.c ****  * /param EventMaskType nextEvent   : The event to be processed [IN]
 220:source\asw/mp3.c ****  * /return RC_SUCCESS
 221:source\asw/mp3.c ****  */
 222:source\asw/mp3.c **** RC_t MP3_ProcessEvent(EventMaskType nextEvent)
 223:source\asw/mp3.c **** {
 224:source\asw/mp3.c ****     //Debugging aid
 225:source\asw/mp3.c ****     //MP3__showEventAndState(nextEvent, MP3__player.m_state);
 226:source\asw/mp3.c ****     
 227:source\asw/mp3.c ****     switch (MP3__player.m_state)
 228:source\asw/mp3.c ****     {
 229:source\asw/mp3.c ****         case MP3STATE_ISSTOPPED :
 230:source\asw/mp3.c ****             if (nextEvent & ev_Button1)
 231:source\asw/mp3.c ****             {
 232:source\asw/mp3.c ****                 MP3__prevSong();
 233:source\asw/mp3.c ****                 MP3__showSong();
 234:source\asw/mp3.c ****             }
 235:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 236:source\asw/mp3.c ****             {
 237:source\asw/mp3.c ****                 MP3__nextSong();
 238:source\asw/mp3.c ****                 MP3__showSong();
 239:source\asw/mp3.c ****             }
 240:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 241:source\asw/mp3.c ****             {
 242:source\asw/mp3.c ****                 MP3__playSong();
 243:source\asw/mp3.c ****                 MP3__showSong();
 244:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 245:source\asw/mp3.c ****             }
 246:source\asw/mp3.c ****             break;
 247:source\asw/mp3.c **** 
 248:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 249:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 250:source\asw/mp3.c ****             {
 251:source\asw/mp3.c ****                 MP3__increaseVolume();
 252:source\asw/mp3.c ****             }
 253:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 254:source\asw/mp3.c ****             {
 255:source\asw/mp3.c ****                 MP3__decreaseVolume();
 256:source\asw/mp3.c ****             }
 257:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 258:source\asw/mp3.c ****             {
 259:source\asw/mp3.c ****                 MP3__pauseSong();
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc3r4HKe.s 			page 6


 260:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
 261:source\asw/mp3.c ****             }
 262:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 263:source\asw/mp3.c ****             {
 264:source\asw/mp3.c ****                 MP3__stopSong();
 265:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 266:source\asw/mp3.c ****             }
 267:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
 268:source\asw/mp3.c ****             {
 269:source\asw/mp3.c ****                 MP3__showRemainingPlaytime();
 270:source\asw/mp3.c ****             }
 271:source\asw/mp3.c ****             else if (nextEvent & ev_1s && MP3__songEnded())
 272:source\asw/mp3.c ****             {
 273:source\asw/mp3.c ****                 MP3__nextSong(); 
 274:source\asw/mp3.c ****                 MP3__playSong();
 275:source\asw/mp3.c ****                 MP3__showSong();
 276:source\asw/mp3.c ****             }
 277:source\asw/mp3.c ****             break;
 278:source\asw/mp3.c ****             
 279:source\asw/mp3.c ****         case MP3STATE_ISPAUSING :
 280:source\asw/mp3.c ****             if (nextEvent & ev_Button3)
 281:source\asw/mp3.c ****             {
 282:source\asw/mp3.c ****                 MP3__resumeSong();
 283:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 284:source\asw/mp3.c ****             }
 285:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 286:source\asw/mp3.c ****             {
 287:source\asw/mp3.c ****                 MP3__stopSong();
