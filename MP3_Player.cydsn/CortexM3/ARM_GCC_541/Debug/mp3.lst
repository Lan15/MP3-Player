 175:source\asw/mp3.c ****                 UART_LOG_PutString("1");
 176:source\asw/mp3.c ****             }
 177:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 178:source\asw/mp3.c ****             {
 179:source\asw/mp3.c ****                 MP3__nextSong();
 180:source\asw/mp3.c ****                 MP3__showSong();
 181:source\asw/mp3.c ****                 UART_LOG_PutString("2");
 182:source\asw/mp3.c ****             }
 183:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 184:source\asw/mp3.c ****             {
 185:source\asw/mp3.c ****                 MP3__playSong();
 186:source\asw/mp3.c ****                 MP3__showSong();
 187:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 188:source\asw/mp3.c ****                 UART_LOG_PutString("3");
 189:source\asw/mp3.c ****             }
 190:source\asw/mp3.c ****             break;
 191:source\asw/mp3.c **** 
 192:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 193:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 194:source\asw/mp3.c ****             {
 195:source\asw/mp3.c ****                 MP3__increaseVolume();
 196:source\asw/mp3.c ****             }
 197:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 198:source\asw/mp3.c ****             {
 199:source\asw/mp3.c ****                 MP3__decreaseVolume();
 200:source\asw/mp3.c ****             }
 201:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 202:source\asw/mp3.c ****             {
