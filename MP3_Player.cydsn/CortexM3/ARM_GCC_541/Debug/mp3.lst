 434:source\asw/mp3.c **** 
 435:source\asw/mp3.c ****                 MP3__readBlock();                           /* INC 5C: pre-fill buffer A, becomes a
 436:source\asw/mp3.c ****                 (void)SOUND_SwapBuffers();
 437:source\asw/mp3.c **** 
 438:source\asw/mp3.c ****                 if (MP3__bytesRemaining > 0u)
 439:source\asw/mp3.c ****                 {
 440:source\asw/mp3.c ****                     MP3__readBlock();                       /* pre-fill buffer B, inactive, ready f
 441:source\asw/mp3.c ****                 }
 442:source\asw/mp3.c **** 
 443:source\asw/mp3.c ****                 (void)SOUND_StartPlay();
 444:source\asw/mp3.c **** 
 445:source\asw/mp3.c ****                 MP3__reader.m_state = MP3READER_STREAMING;
 446:source\asw/mp3.c ****             }
 447:source\asw/mp3.c ****             break;
 448:source\asw/mp3.c ****         }
 449:source\asw/mp3.c **** 
 450:source\asw/mp3.c ****         case MP3READER_STREAMING:
 451:source\asw/mp3.c ****         {
