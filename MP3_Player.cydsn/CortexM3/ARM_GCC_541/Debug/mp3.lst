 163:source\asw/mp3.c ****     /* Scan SD card for WAV files */
 164:source\asw/mp3.c ****     UART_LOG_PutString("\r\n[MP3] Scanning SD card...\n");
 165:source\asw/mp3.c ****     
 166:source\asw/mp3.c ****     FS_Init(); 
 167:source\asw/mp3.c ****     
 168:source\asw/mp3.c ****     pDir = FS_OpenDir(MP3__SD_ROOT);
 169:source\asw/mp3.c ****     if (pDir == 0)
 170:source\asw/mp3.c ****     {
 171:source\asw/mp3.c ****         UART_LOG_PutString("\r\n[MP3] ERROR: cannot open root dir\n");
 172:source\asw/mp3.c ****         /* Fall back to flash songs */
 173:source\asw/mp3.c ****         MP3__player.m_noSongs = SOUND_NoOfRecords;
 174:source\asw/mp3.c ****         uint16_t i;
