 285:source\asw/mp3.c **** RC_t MP3_ProcessEvent(EventMaskType nextEvent)
 286:source\asw/mp3.c **** {
 287:source\asw/mp3.c **** #if (MP3__DEBUG_LOG != 0u)
 288:source\asw/mp3.c ****     MP3__showEventAndState(nextEvent, MP3__player.m_state);
 289:source\asw/mp3.c **** #endif
 290:source\asw/mp3.c **** 
 291:source\asw/mp3.c ****     /* INC 10C: nothing to play -> ignore all events. This also protects
 292:source\asw/mp3.c ****        the "% m_noSongs" in MP3__nextSong() against a division by zero (N8). */
 293:source\asw/mp3.c ****     if ((MP3__player.m_noSongs != 0u) || (MP3__player.m_state != MP3STATE_ISSTOPPED))
 294:source\asw/mp3.c ****     {
 295:source\asw/mp3.c ****         /* INC 10C: any button press acknowledges a shown error (N8) */
 296:source\asw/mp3.c ****         if (nextEvent & MP3__BUTTON_MASK)
 297:source\asw/mp3.c ****         {
 298:source\asw/mp3.c ****             MP3__error = FALSE;
 299:source\asw/mp3.c ****         }
 300:source\asw/mp3.c **** 
 301:source\asw/mp3.c ****         switch (MP3__player.m_state)
 302:source\asw/mp3.c ****         {
 303:source\asw/mp3.c ****             case MP3STATE_ISSTOPPED:
 304:source\asw/mp3.c ****                 if (nextEvent & ev_Button1)
 305:source\asw/mp3.c ****                 {
 306:source\asw/mp3.c ****                     MP3__prevSong();
 307:source\asw/mp3.c ****                 }
 308:source\asw/mp3.c ****                 else if (nextEvent & ev_Button2)
 309:source\asw/mp3.c ****                 {
 310:source\asw/mp3.c ****                     MP3__nextSong();
 311:source\asw/mp3.c ****                 }
 312:source\asw/mp3.c ****                 else if (nextEvent & ev_Button3)
 313:source\asw/mp3.c ****                 {
 314:source\asw/mp3.c ****                     MP3__reader.m_failCount = 0u;               /* INC 7: fresh start (reader is ID
