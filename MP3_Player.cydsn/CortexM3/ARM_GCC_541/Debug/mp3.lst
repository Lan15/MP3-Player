 260:source\asw/mp3.c ****                 MP3__reader.m_state = MP3READER_IDLE;
 261:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 262:source\asw/mp3.c ****                 break;
 263:source\asw/mp3.c ****             }
 264:source\asw/mp3.c **** 
 265:source\asw/mp3.c ****             /* Set remaining play time from WAV header                    */
 266:source\asw/mp3.c ****             /* seconds = data bytes / (samples per s * bytes per sample)  */
 267:source\asw/mp3.c ****             MP3__player.m_remainingPlayTime =
 268:source\asw/mp3.c ****                 (uint16_t)(MP3__wavInfo.data_length
 269:source\asw/mp3.c ****                            / ((uint32_t)MP3__wavInfo.header.sample_rate
 270:source\asw/mp3.c ****                               * MP3__wavInfo.header.block_align));
 271:source\asw/mp3.c ****             SEVEN_Set(SEVEN_0, MP3__player.m_remainingPlayTime);
 272:source\asw/mp3.c **** 
 273:source\asw/mp3.c ****             /*sprintf(logBuf, "\r\n[MP3] Playtime: %u s (%u-bit)\n",
 274:source\asw/mp3.c ****                     MP3__player.m_remainingPlayTime,
 275:source\asw/mp3.c ****                     MP3__wavInfo.header.bits_per_sample);
 276:source\asw/mp3.c ****             UART_LOG_PutString(logBuf);*/
 277:source\asw/mp3.c **** 
 278:source\asw/mp3.c ****             /* Pre-fill Buffer A - becomes active */                // INC 5C
 279:source\asw/mp3.c ****             MP3__ReadBlock();
 280:source\asw/mp3.c ****             SOUND_SwapBuffers();
 281:source\asw/mp3.c **** 
 282:source\asw/mp3.c ****             /* Pre-fill Buffer B - inactive, ready for first swap */
 283:source\asw/mp3.c ****             if (MP3__bytesRemaining > 0u)
 284:source\asw/mp3.c ****             {
 285:source\asw/mp3.c ****                 MP3__ReadBlock();
 286:source\asw/mp3.c ****             }
 287:source\asw/mp3.c **** 
 288:source\asw/mp3.c ****             SOUND_StartPlay();
 289:source\asw/mp3.c **** 
 290:source\asw/mp3.c ****             MP3__reader.m_state = MP3READER_STREAMING;
 291:source\asw/mp3.c ****             break;
 292:source\asw/mp3.c ****         }
 293:source\asw/mp3.c ****  
 294:source\asw/mp3.c ****         case MP3READER_STREAMING:
 295:source\asw/mp3.c ****         {
 296:source\asw/mp3.c ****             /* Stop/pause request from tsk_control */
 297:source\asw/mp3.c ****             if (MP3__reader.m_state == MP3READER_IDLE)
 298:source\asw/mp3.c ****             {
 299:source\asw/mp3.c ****                 break;
