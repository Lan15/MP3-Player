1047:source\asw/mp3.c **** /**
1048:source\asw/mp3.c ****  * \brief Scan the whole card from the root and store all WAV files in MP3__songList.
1049:source\asw/mp3.c ****  *
1050:source\asw/mp3.c ****  * Stores the full path of each WAV file, e.g. "\MUSIC\SONG.WAV". Entries
1051:source\asw/mp3.c ****  * starting with '.', hidden and system entries are skipped. The scan stops when
1052:source\asw/mp3.c ****  * the list is full. Subfolders are scanned down to MP3__SCAN_MAX_DEPTH levels.
1053:source\asw/mp3.c ****  *
1054:source\asw/mp3.c ****  * It is a loop with an explicit level counter instead of a recursive function
1055:source\asw/mp3.c ****  * (MISRA C:2012 Rule 17.2). The parent folder is closed while a subfolder is
1056:source\asw/mp3.c ****  * scanned and opened again afterwards, skipping what was already read (N6).
1057:source\asw/mp3.c ****  */
1058:source\asw/mp3.c **** static void MP3__scanSD(void)
1059:source\asw/mp3.c **** {
 740              		.loc 1 1059 0
 741              		.cfi_startproc
