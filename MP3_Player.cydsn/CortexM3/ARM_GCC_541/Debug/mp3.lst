 410:source\asw/mp3.c ****                 strstr(entryName, ".wav") != 0)
 411:source\asw/mp3.c ****             {
 412:source\asw/mp3.c ****                 strncpy(MP3__songList[songCount], entryName,
 413:source\asw/mp3.c ****                         MP3_FILENAME_MAXLEN - 1u);
 414:source\asw/mp3.c ****                 MP3__songList[songCount][MP3_FILENAME_MAXLEN - 1u] = '\0';
 415:source\asw/mp3.c ****                 songCount++;
 416:source\asw/mp3.c ****  
 417:source\asw/mp3.c ****                 //sprintf(logBuf, "\r\n[MP3] Found: %s\n", entryName);
 418:source\asw/mp3.c ****                 //UART_LOG_PutString(logBuf);
 419:source\asw/mp3.c ****             }
 420:source\asw/mp3.c ****         }
 421:source\asw/mp3.c ****         FS_CloseDir(pDir);
 422:source\asw/mp3.c ****         MP3__player.m_noSongs = songCount;
 423:source\asw/mp3.c ****     }
 424:source\asw/mp3.c **** }
