 566:source\asw/mp3.c ****  * selected = BLACK on DARKBLUE with "(*)", others = GREEN on BLACK with "( )". */
 567:source\asw/mp3.c **** static void MP3__drawRow(uint16_t i, uint16_t selected)
 568:source\asw/mp3.c **** {
 569:source\asw/mp3.c ****     boolean_t sel = (i == selected);
 570:source\asw/mp3.c **** 
