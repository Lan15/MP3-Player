 365:source\asw/mp3.c ****     {
 366:source\asw/mp3.c ****         UART_LOG_PutString("\r\n[MP3] ERROR: cannot open root dir\n");
 367:source\asw/mp3.c ****         /* Fall back to flash songs */
 368:source\asw/mp3.c ****         MP3__player.m_noSongs = SOUND_NoOfRecords;
 369:source\asw/mp3.c ****         uint16_t i;
