 263:source\asw/mp3.c ****     MP3__player.m_volume      = MP3__MAXVOLUME;
 264:source\asw/mp3.c ****     MP3__player.m_currentSong = 0u;
 265:source\asw/mp3.c ****     MP3__player.m_noSongs     = 0u;
 266:source\asw/mp3.c ****  
 267:source\asw/mp3.c ****     MP3__reader.m_state          = MP3READER_IDLE;
