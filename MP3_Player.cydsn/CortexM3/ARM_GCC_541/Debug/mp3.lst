 203:source\asw/mp3.c ****                 MP3__pauseSong();
 204:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
 205:source\asw/mp3.c ****             }
 206:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 207:source\asw/mp3.c ****             {
 208:source\asw/mp3.c ****                 MP3__stopSong();
 209:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 210:source\asw/mp3.c ****             }
 211:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
 212:source\asw/mp3.c ****             {
 213:source\asw/mp3.c ****                 MP3__showRemainingPlaytime();
 214:source\asw/mp3.c ****             }
 215:source\asw/mp3.c ****             else if (nextEvent & ev_1s && MP3__songEnded())
 216:source\asw/mp3.c ****             {
