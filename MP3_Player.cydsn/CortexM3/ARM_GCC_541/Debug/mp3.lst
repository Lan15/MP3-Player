 223:source\asw/mp3.c ****             
 224:source\asw/mp3.c ****         case MP3STATE_ISPAUSING :
 225:source\asw/mp3.c ****             if (nextEvent & ev_Button3)
 226:source\asw/mp3.c ****             {
