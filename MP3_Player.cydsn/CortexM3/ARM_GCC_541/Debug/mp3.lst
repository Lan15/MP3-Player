 523:source\asw/mp3.c ****         mode = MP3__DISP_MODE_LIST;
 524:source\asw/mp3.c ****     }
 525:source\asw/mp3.c **** 
 526:source\asw/mp3.c ****     if (mode != MP3__dispMode)
 527:source\asw/mp3.c ****     {
 528:source\asw/mp3.c ****         MP3__switchMode(mode);                      /* kind of content changed (N9) */
 529:source\asw/mp3.c ****     }
