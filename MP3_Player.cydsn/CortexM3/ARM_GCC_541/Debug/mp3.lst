 203:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 204:source\asw/mp3.c ****             {
 205:source\asw/mp3.c ****                 MP3__stopSong();
 206:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
 207:source\asw/mp3.c ****             }
 208:source\asw/mp3.c ****             else if (nextEvent & ev_1s && !MP3__songEnded())
 209:source\asw/mp3.c ****             {
 210:source\asw/mp3.c ****                 MP3__showRemainingPlaytime();
 211:source\asw/mp3.c ****             }
 212:source\asw/mp3.c ****             else if (nextEvent & ev_1s && MP3__songEnded())
 213:source\asw/mp3.c ****             {
 214:source\asw/mp3.c ****                 MP3__nextSong(); 
 215:source\asw/mp3.c ****                 MP3__playSong();
