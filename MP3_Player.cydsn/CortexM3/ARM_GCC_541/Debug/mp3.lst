 274:source\asw/mp3.c ****  
 275:source\asw/mp3.c ****             /* Set remaining play time from WAV header                    */    // INC 5B
 276:source\asw/mp3.c ****             /* seconds = data bytes / (samples per s * bytes per sample)  */
 277:source\asw/mp3.c ****             /* 8-bit mono: block_align = 1, 16-bit mono: block_align = 2  */
 278:source\asw/mp3.c ****             MP3__player.m_remainingPlayTime =
 279:source\asw/mp3.c ****                 (uint16_t)(MP3__wavInfo.data_length
 280:source\asw/mp3.c ****                            / ((uint32_t)MP3__wavInfo.header.sample_rate
 281:source\asw/mp3.c ****                               * MP3__wavInfo.header.block_align));
 282:source\asw/mp3.c ****             SEVEN_Set(SEVEN_0, MP3__player.m_remainingPlayTime);
 283:source\asw/mp3.c ****             
 284:source\asw/mp3.c ****             sprintf(logBuf, "\r\n[MP3] Playtime: %u s (%u-bit)\n",
 285:source\asw/mp3.c ****                     MP3__player.m_remainingPlayTime,
 286:source\asw/mp3.c ****                     MP3__wavInfo.header.bits_per_sample);
 287:source\asw/mp3.c ****             UART_LOG_PutString(logBuf);
 288:source\asw/mp3.c ****             
 289:source\asw/mp3.c ****             /* Pre-fill Buffer A - becomes active */
 290:source\asw/mp3.c ****             fillSize = (MP3__bytesRemaining >= SOUND_BUFFER_SIZE)
 291:source\asw/mp3.c ****                         ? SOUND_BUFFER_SIZE
 292:source\asw/mp3.c ****                         : (uint16_t)MP3__bytesRemaining;
 293:source\asw/mp3.c ****  
 294:source\asw/mp3.c ****             bytesRead = FS_Read(MP3__pFile, MP3__readBuf, fillSize);
 295:source\asw/mp3.c ****             MP3__bytesRemaining -= (uint32_t)bytesRead;
 296:source\asw/mp3.c ****             SOUND_FillBuffer(MP3__readBuf, (uint16_t)bytesRead);
 297:source\asw/mp3.c ****             SOUND_SwapBuffers();
 298:source\asw/mp3.c ****  
 299:source\asw/mp3.c ****             /* Pre-fill Buffer B - inactive, ready for first swap */
 300:source\asw/mp3.c ****             if (MP3__bytesRemaining > 0u)
 301:source\asw/mp3.c ****             {
 302:source\asw/mp3.c ****                 fillSize = (MP3__bytesRemaining >= SOUND_BUFFER_SIZE)
 303:source\asw/mp3.c ****                             ? SOUND_BUFFER_SIZE
 304:source\asw/mp3.c ****                             : (uint16_t)MP3__bytesRemaining;
 305:source\asw/mp3.c ****  
