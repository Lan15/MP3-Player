 575:source\asw/mp3.c ****     TFT_setTextWrap(FALSE);
 576:source\asw/mp3.c ****     TFT_setColors(sel ? BLACK : GREEN, sel ? DARKBLUE : BLACK);
 577:source\asw/mp3.c **** 
 578:source\asw/mp3.c ****     TFT_setCursor(2, 20 + i * 12);
 579:source\asw/mp3.c ****     TFT_printf("%s %s", sel ? "(*)" : "( )", MP3__songList[i]);
