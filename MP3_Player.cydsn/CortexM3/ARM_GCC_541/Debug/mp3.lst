 180:source\asw/mp3.c ****             }
 181:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 182:source\asw/mp3.c ****             {
 183:source\asw/mp3.c ****                 MP3__playSong();
 184:source\asw/mp3.c ****                 MP3__showSong();
 185:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPLAYING;
 186:source\asw/mp3.c ****             }
 187:source\asw/mp3.c ****             break;
 188:source\asw/mp3.c **** 
 189:source\asw/mp3.c ****         case MP3STATE_ISPLAYING :
 190:source\asw/mp3.c ****             if (nextEvent & ev_Button1)         
 191:source\asw/mp3.c ****             {
 192:source\asw/mp3.c ****                 MP3__increaseVolume();
 193:source\asw/mp3.c ****             }
 194:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 195:source\asw/mp3.c ****             {
 196:source\asw/mp3.c ****                 MP3__decreaseVolume();
 197:source\asw/mp3.c ****             }
 198:source\asw/mp3.c ****             else if (nextEvent & ev_Button3)
 199:source\asw/mp3.c ****             {
 200:source\asw/mp3.c ****                 MP3__pauseSong();
 201:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISPAUSING;
 202:source\asw/mp3.c ****             }
