 206:source\asw/mp3.c ****             else if (nextEvent & ev_Button4)
 207:source\asw/mp3.c ****             {
 208:source\asw/mp3.c ****                 MP3__stopSong();
 209:source\asw/mp3.c ****                 MP3__player.m_state = MP3STATE_ISSTOPPED;
