 317:source\asw/mp3.c ****                 }
 318:source\asw/mp3.c ****                 else
 319:source\asw/mp3.c ****                 {
 320:source\asw/mp3.c ****                     /* Button4 and ev_1s have no function while stopped */
 321:source\asw/mp3.c ****                 }
 322:source\asw/mp3.c ****                 break;
 323:source\asw/mp3.c **** 
 324:source\asw/mp3.c ****             case MP3STATE_ISPLAYING:
 325:source\asw/mp3.c ****                 if (nextEvent & ev_Button1)
 326:source\asw/mp3.c ****                 {
 327:source\asw/mp3.c ****                     MP3__increaseVolume();
 328:source\asw/mp3.c ****                 }
 329:source\asw/mp3.c ****                 else if (nextEvent & ev_Button2)
 330:source\asw/mp3.c ****                 {
 331:source\asw/mp3.c ****                     MP3__decreaseVolume();
 332:source\asw/mp3.c ****                 }
 333:source\asw/mp3.c ****                 else if (nextEvent & ev_Button3)
