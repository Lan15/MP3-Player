 233:source\asw/mp3.c ****                 MP3__showSong();
 234:source\asw/mp3.c ****             }
 235:source\asw/mp3.c ****             else if (nextEvent & ev_Button2)
 236:source\asw/mp3.c ****             {
 237:source\asw/mp3.c ****                 MP3__nextSong();
