 536:source\asw/wav_parser.c **** /**
 537:source\asw/wav_parser.c ****  * \brief Parse the header of an open emFile WAV file.
 538:source\asw/wav_parser.c ****  *
 539:source\asw/wav_parser.c ****  * Checks the pointers, then lets WAV__ParseChunks() do the work. After a successful
 540:source\asw/wav_parser.c ****  * call the file position is on the first PCM byte (N6). The function seeks to
 541:source\asw/wav_parser.c ****  * offset 0 itself. Header bytes come through one read window (N1).
 542:source\asw/wav_parser.c ****  *
 543:source\asw/wav_parser.c ****  * Not re-entrant (static read window), call from tsk_reader only (N8).
 544:source\asw/wav_parser.c ****  *
 545:source\asw/wav_parser.c ****  * \param FS_FILE *const pFile         : [IN]  open emFile handle (mode "r"), not NULL
 546:source\asw/wav_parser.c ****  * \param WAVFile *const wav           : [OUT] structure to fill, not NULL; header fields and data_
 547:source\asw/wav_parser.c ****  *                                     (limited to the bytes left in the file, N5) are valid on RC_
 548:source\asw/wav_parser.c ****  * \return RC_SUCCESS when the header is valid, FS_FTell() gives the offset of the
 549:source\asw/wav_parser.c ****  *         first PCM byte,
 550:source\asw/wav_parser.c ****  *         RC_ERROR_NULL when pFile or wav is NULL (nothing is read, no UART output),
 551:source\asw/wav_parser.c ****  *         RC_ERROR_READ_FAILS when a seek or read failed (reason on the UART),
 552:source\asw/wav_parser.c ****  *         RC_ERROR_INVALID when the file is not RIFF/WAVE, the fmt chunk is too small,
 553:source\asw/wav_parser.c ****  *         the header fields contradict each other (block_align), data comes before
 554:source\asw/wav_parser.c ****  *         fmt or there is no data chunk (reason on the UART),
 555:source\asw/wav_parser.c ****  *         RC_ERROR_NOT_IMPLEMENTED when the file is valid but not playable: not PCM,
 556:source\asw/wav_parser.c ****  *         not 1/2 channels, not 8/16/24 bit or not 22050/44100 Hz (reason on the UART)
 557:source\asw/wav_parser.c ****  */
