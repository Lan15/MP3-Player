 397:source\asw/wav_parser.c **** /**
 398:source\asw/wav_parser.c ****  * \brief Walk the RIFF chunk list and fill the WAVFile (body of WAV_ParseHeader).
 399:source\asw/wav_parser.c ****  *
 400:source\asw/wav_parser.c ****  * Reads the RIFF header, walks the chunk list (at most WAV__MAX_CHUNKS chunks),
 401:source\asw/wav_parser.c ****  * decodes and validates the 'fmt ' chunk (N4, N9), finds the 'data' chunk and
 402:source\asw/wav_parser.c ****  * leaves the file position on its first PCM byte (N6). Header bytes come through
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc7lWg6g.s 			page 21


 403:source\asw/wav_parser.c ****  * one read window (N1). The return codes are described in N10.
 404:source\asw/wav_parser.c ****  *
 405:source\asw/wav_parser.c ****  * \param FS_FILE *const pFile         : [IN]  open emFile handle, not NULL (checked by WAV_ParseHe
 406:source\asw/wav_parser.c ****  * \param WAVFile *const wav           : [OUT] structure to fill, not NULL (checked by WAV_ParseHea
 407:source\asw/wav_parser.c ****  * \return RC_SUCCESS, RC_ERROR_READ_FAILS, RC_ERROR_INVALID or RC_ERROR_NOT_IMPLEMENTED,
 408:source\asw/wav_parser.c ****  *         see WAV_ParseHeader()
 409:source\asw/wav_parser.c ****  */
 410:source\asw/wav_parser.c **** static RC_t WAV__ParseChunks(FS_FILE * const pFile, WAVFile * const wav)
 411:source\asw/wav_parser.c **** {
