 380:source\asw/wav_parser.c **** /**
 381:source\asw/wav_parser.c ****  * \brief Parse the header of an open emFile WAV file.
 382:source\asw/wav_parser.c ****  *
 383:source\asw/wav_parser.c ****  * Reads the RIFF header, walks the chunk list (at most WAV__MAX_CHUNKS chunks),
 384:source\asw/wav_parser.c ****  * decodes and validates the 'fmt ' chunk (N4, N9), finds the 'data' chunk and
 385:source\asw/wav_parser.c ****  * leaves the file position on its first PCM byte (N6). The function seeks to
 386:source\asw/wav_parser.c ****  * offset 0 itself. Header bytes come through one read window (N1).
 387:source\asw/wav_parser.c ****  *
 388:source\asw/wav_parser.c ****  * \param[in]  pFile  open emFile handle (mode "r"), not NULL
 389:source\asw/wav_parser.c ****  * \param[out] wav    structure to fill, not NULL; header fields and data_length
 390:source\asw/wav_parser.c ****  *                    (limited to the bytes left in the file, N5) are valid on RC_SUCCESS
 391:source\asw/wav_parser.c ****  * \return RC_SUCCESS header valid, FS_FTell() gives the offset of the first PCM byte
 392:source\asw/wav_parser.c ****  * \return RC_ERROR   read or seek failed, not RIFF/WAVE, unsupported format or no data
 393:source\asw/wav_parser.c ****  *                    chunk; a line "[WAV] ERROR: ..." was written to the UART log
 394:source\asw/wav_parser.c ****  *
 395:source\asw/wav_parser.c ****  * \note Not re-entrant (static read window), call from tsk_reader only.
 396:source\asw/wav_parser.c ****  */
