 195:source\asw/wav_parser.c **** /**
 196:source\asw/wav_parser.c ****  * \brief Return a pointer to n header bytes at a file offset (N1).
 197:source\asw/wav_parser.c ****  *
 198:source\asw/wav_parser.c ****  * If the bytes are not in the window the window is reloaded at that offset
 199:source\asw/wav_parser.c ****  * (one FS_FSeek and one FS_Read of WAV__WIN_SIZE bytes). The returned pointer
 200:source\asw/wav_parser.c ****  * is only valid until the next call, because a reload overwrites the window.
 201:source\asw/wav_parser.c ****  *
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccvvxxwP.s 			page 7


