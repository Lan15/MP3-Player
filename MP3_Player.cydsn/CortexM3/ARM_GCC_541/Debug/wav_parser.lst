 251:source\asw/wav_parser.c ****     }
 252:source\asw/wav_parser.c ****     else if ((hdr->number_of_channels != WAV__CH_MONO) &&
 253:source\asw/wav_parser.c ****              (hdr->number_of_channels != WAV__CH_STEREO))
 254:source\asw/wav_parser.c ****     {
 255:source\asw/wav_parser.c ****         UART_LOG_PutString("\r\n[WAV] ERROR: not mono/stereo\n");
 256:source\asw/wav_parser.c ****     }
 257:source\asw/wav_parser.c ****     else if ((hdr->bits_per_sample != WAV__BITS_8)  &&
 258:source\asw/wav_parser.c ****              (hdr->bits_per_sample != WAV__BITS_16) &&
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccvvxxwP.s 			page 8


 259:source\asw/wav_parser.c ****              (hdr->bits_per_sample != WAV__BITS_24))
 260:source\asw/wav_parser.c ****     {
 261:source\asw/wav_parser.c ****         UART_LOG_PutString("\r\n[WAV] ERROR: not 8/16/24-bit\n");
 262:source\asw/wav_parser.c ****     }
 263:source\asw/wav_parser.c ****     else if ((uint32_t)hdr->block_align !=
 264:source\asw/wav_parser.c ****              ((uint32_t)hdr->number_of_channels * ((uint32_t)hdr->bits_per_sample / 8u)))
 265:source\asw/wav_parser.c ****     {
 266:source\asw/wav_parser.c ****         /* One frame = one sample for every channel */
 267:source\asw/wav_parser.c ****         UART_LOG_PutString("\r\n[WAV] ERROR: bad block_align\n");
 268:source\asw/wav_parser.c ****     }
 269:source\asw/wav_parser.c ****     else if ((hdr->sample_rate != WAV__SAMPLE_RATE) &&
 270:source\asw/wav_parser.c ****              (hdr->sample_rate != (2u * WAV__SAMPLE_RATE)))
 271:source\asw/wav_parser.c ****     {
 272:source\asw/wav_parser.c ****         /* 22050 Hz is played directly, 44100 Hz is decimated by 2 in MP3__readBlock() */
 273:source\asw/wav_parser.c ****         WAV__LogNumber("\r\n[WAV] ERROR: ", hdr->sample_rate, " Hz, need 22050/44100\n");
 274:source\asw/wav_parser.c ****     }
 275:source\asw/wav_parser.c ****     else
 276:source\asw/wav_parser.c ****     {
 277:source\asw/wav_parser.c ****         rc = RC_SUCCESS;
 278:source\asw/wav_parser.c ****     }
 279:source\asw/wav_parser.c ****     return rc;
 280:source\asw/wav_parser.c **** }
