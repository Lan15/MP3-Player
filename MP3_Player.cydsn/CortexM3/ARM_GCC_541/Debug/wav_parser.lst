  61:source\asw/wav_parser.c **** /**
  62:source\asw/wav_parser.c ****  * \brief Read a 32-bit little-endian value from a byte array.
  63:source\asw/wav_parser.c ****  *
  64:source\asw/wav_parser.c ****  * The PSoC 5LP (Cortex-M3) is itself little-endian, so this is a safe
  65:source\asw/wav_parser.c ****  * byte-by-byte reconstruction that avoids unaligned access and is
  66:source\asw/wav_parser.c ****  * endian-explicit rather than relying on cast behaviour.
  67:source\asw/wav_parser.c ****  *
  68:source\asw/wav_parser.c ****  * \param[in] data  Pointer to the first of four bytes
  69:source\asw/wav_parser.c ****  * \return          32-bit value in host (little-endian) byte order
  70:source\asw/wav_parser.c ****  */
  71:source\asw/wav_parser.c **** static uint32_t WAV__ReadU32(uint8_t const * const data);
  72:source\asw/wav_parser.c **** 
  73:source\asw/wav_parser.c **** /**
  74:source\asw/wav_parser.c ****  * \brief Read a 16-bit little-endian value from a byte array.
  75:source\asw/wav_parser.c ****  *
  76:source\asw/wav_parser.c ****  * \param[in] data  Pointer to the first of two bytes
  77:source\asw/wav_parser.c ****  * \return          16-bit value in host byte order
  78:source\asw/wav_parser.c ****  */
  79:source\asw/wav_parser.c **** static uint16_t WAV__ReadU16(uint8_t const * const data);
