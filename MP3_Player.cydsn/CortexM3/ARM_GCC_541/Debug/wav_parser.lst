 244:source\asw/wav_parser.c **** static RC_t WAV__ValidateFormat(WAVHeader const * const hdr)
 245:source\asw/wav_parser.c **** {
 246:source\asw/wav_parser.c ****     RC_t rc = RC_ERROR;
 247:source\asw/wav_parser.c **** 
 248:source\asw/wav_parser.c ****     if (hdr->audio_format != WAV_AUDIO_FORMAT_PCM)          /* EXTENSIBLE is already resolved to it
 249:source\asw/wav_parser.c ****     {
