 100:source\asw/main.c **** //ISR which will increment the systick counter every ms
 101:source\asw/main.c **** /**
 102:source\asw/main.c ****  * \brief System tick interrupt, every 1 ms: advance the counter cnt_systick.
 103:source\asw/main.c ****  *
 104:source\asw/main.c ****  * cnt_systick is the time base of the alarms alrm_1s and alrm_display (N5), so
 105:source\asw/main.c ****  * one counter tick is one millisecond.
 106:source\asw/main.c ****  *
 107:source\asw/main.c ****  * \note Keep it short, it is called 1000 times per second.
 108:source\asw/main.c ****  */
 109:source\asw/main.c **** ISR(systick_handler)
