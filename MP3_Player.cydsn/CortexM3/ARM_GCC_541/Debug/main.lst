ARM GAS  C:\Users\agila\AppData\Local\Temp\ccuXcuy4.s 			page 30


 290:source\asw/main.c ****     if (WAV_ParseHeader(pFile, &wavFile) == RC_SUCCESS)
 291:source\asw/main.c ****     {
