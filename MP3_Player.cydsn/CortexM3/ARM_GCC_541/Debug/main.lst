 293:source\asw/main.c ****         UART_LOG_PutString("\r\n[WAV] Header OK\n");
 294:source\asw/main.c **** 
 295:source\asw/main.c ****         /* File pointer now at byte 78 — first PCM sample      */
 296:source\asw/main.c ****         /* Read first 512 bytes into read buffer               */
 297:source\asw/main.c ****         static uint8_t readBuf[512];
 298:source\asw/main.c ****         U32 bytesRead = FS_Read(pFile, readBuf, 512u);
 299:source\asw/main.c **** 
 300:source\asw/main.c ****         sprintf(logBuf, "\r\n[4B2] FS_Read: %lu bytes\n", bytesRead);
 301:source\asw/main.c ****         UART_LOG_PutString(logBuf);
 302:source\asw/main.c **** 
 303:source\asw/main.c ****         /* Fill dual buffer */
 304:source\asw/main.c ****         if (SOUND_FillBuffer(readBuf, (uint16_t)bytesRead) == RC_SUCCESS)
 305:source\asw/main.c ****         {
 306:source\asw/main.c ****             UART_LOG_PutString("\r\n[4B2] FillBuffer OK\n");
 307:source\asw/main.c ****             SOUND_SwapBuffers();
 308:source\asw/main.c ****             UART_LOG_PutString("\r\n[4B2] SwapBuffers OK\n");
 309:source\asw/main.c ****         }
 310:source\asw/main.c ****         else
 311:source\asw/main.c ****         {
 312:source\asw/main.c ****             UART_LOG_PutString("\r\n[4B2] ERROR: FillBuffer failed\n");
 313:source\asw/main.c ****         }
 314:source\asw/main.c **** 
 315:source\asw/main.c ****         /* Print first 32 bytes to verify PCM data             */
 316:source\asw/main.c ****         /* For 8-bit unsigned PCM silence = 0x80               */
 317:source\asw/main.c ****         /* Music samples should vary around 0x80               */
 318:source\asw/main.c ****         UART_LOG_PutString("\r\n[4B2] First 32 bytes: ");
 319:source\asw/main.c ****         uint8_t k;
 320:source\asw/main.c ****         for (k = 0u; k < 32u; k++)
 321:source\asw/main.c ****         {
 322:source\asw/main.c ****             sprintf(logBuf, "%02X ", readBuf[k]);
 323:source\asw/main.c ****             UART_LOG_PutString(logBuf);
 324:source\asw/main.c ****         }
 325:source\asw/main.c ****         UART_LOG_PutString("\n");
 326:source\asw/main.c ****     }
 327:source\asw/main.c ****     
 328:source\asw/main.c ****     /*  The bytes should vary around 0x80 (128 decimal) which is the mid-rail for 8-bit unsigned PC
 329:source\asw/main.c ****         If you see all 0x80 - the file pointer is wrong. If you see all 0x00 - the buffer was not f
 330:source\asw/main.c ****         If you see values like 7E 80 82 7F varying around 0x80 - the PCM data is correct. */
 331:source\asw/main.c ****     else
 332:source\asw/main.c ****     {
 333:source\asw/main.c ****         UART_LOG_PutString("\r\n[WAV] ERROR: invalid header\n");
 334:source\asw/main.c ****     }
 335:source\asw/main.c ****  
 336:source\asw/main.c ****     FS_FClose(pFile);
 337:source\asw/main.c ****     TerminateTask();
 338:source\asw/main.c **** }
