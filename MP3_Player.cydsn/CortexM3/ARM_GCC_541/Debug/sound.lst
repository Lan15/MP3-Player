 111:source\asw/sound.c ****  * /return RC_SUCCESS
 112:source\asw/sound.c ****  *
 113:source\asw/sound.c **** RC_t SOUND_Init()
 114:source\asw/sound.c **** {
 115:source\asw/sound.c ****     //Set the MUX to channel 1
 116:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
 117:source\asw/sound.c ****     
 118:source\asw/sound.c ****     //Enable power supply
 119:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
 120:source\asw/sound.c **** 
 121:source\asw/sound.c ****     //Disable the song sample timer
 122:source\asw/sound.c ****     SOUND_StopPlay();
 123:source\asw/sound.c **** 
 124:source\asw/sound.c ****     //Initialize PWM and Clock
 125:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
 126:source\asw/sound.c ****     SOUND_PWM_Start();
 127:source\asw/sound.c ****     SOUND_PWM_WriteCompare(0);
 128:source\asw/sound.c ****     
 129:source\asw/sound.c ****     
 130:source\asw/sound.c ****     return RC_SUCCESS;
 131:source\asw/sound.c **** }
 132:source\asw/sound.c **** */
 133:source\asw/sound.c **** 
 134:source\asw/sound.c **** RC_t SOUND_Init()
 135:source\asw/sound.c **** {
 136:source\asw/sound.c ****     /* Pre-fill both buffers with silence — no click on start */
 137:source\asw/sound.c ****     memset(SOUND__bufA, SOUND_SILENCE, SOUND_BUFFER_SIZE);
 138:source\asw/sound.c ****     memset(SOUND__bufB, SOUND_SILENCE, SOUND_BUFFER_SIZE);
 139:source\asw/sound.c **** 
 140:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
 141:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
 142:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
 143:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
 144:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 145:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 146:source\asw/sound.c **** 
 147:source\asw/sound.c ****     /* Flash path: cleared */
 148:source\asw/sound.c ****     SOUND__currentSong.m_song = 0;
 149:source\asw/sound.c ****     SOUND__currentSong.m_size = 0;
 150:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0;
 151:source\asw/sound.c **** 
 152:source\asw/sound.c ****     /* Hardware init */
 153:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
 154:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
 155:source\asw/sound.c ****     SOUND_StopPlay();
 156:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
 157:source\asw/sound.c ****     SOUND_PWM_Start();
 158:source\asw/sound.c ****     SOUND_PWM_WriteCompare(SOUND_SILENCE);
 159:source\asw/sound.c **** 
 160:source\asw/sound.c ****     return RC_SUCCESS;
 161:source\asw/sound.c **** }
 162:source\asw/sound.c **** 
