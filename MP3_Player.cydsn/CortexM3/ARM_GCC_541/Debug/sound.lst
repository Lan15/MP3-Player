  61:source\asw/sound.c **** /**
  62:source\asw/sound.c ****  * Init Function for the sound driver
  63:source\asw/sound.c ****  * /return RC_SUCCESS
  64:source\asw/sound.c ****  */
  65:source\asw/sound.c **** RC_t SOUND_Init()
  66:source\asw/sound.c **** {
  67:source\asw/sound.c ****     //Set the MUX to channel 1
  68:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
  69:source\asw/sound.c ****     
  70:source\asw/sound.c ****     //Enable power supply
  71:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
  72:source\asw/sound.c **** 
  73:source\asw/sound.c ****     //Disable the song sample timer
  74:source\asw/sound.c ****     SOUND_StopPlay();
  75:source\asw/sound.c **** 
  76:source\asw/sound.c ****     //Initialize PWM and Clock
  77:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
  78:source\asw/sound.c ****     SOUND_PWM_Start();
  79:source\asw/sound.c ****     SOUND_PWM_WriteCompare(0);
  80:source\asw/sound.c ****     
  81:source\asw/sound.c ****     
  82:source\asw/sound.c ****     return RC_SUCCESS;
  83:source\asw/sound.c **** }
