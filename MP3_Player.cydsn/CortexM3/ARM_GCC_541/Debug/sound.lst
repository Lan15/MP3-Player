 119:source\asw/sound.c ****     //isr_Timer_Disable();
 120:source\asw/sound.c ****     
 121:source\asw/sound.c ****     return RC_SUCCESS;
 122:source\asw/sound.c **** }
 123:source\asw/sound.c **** 
 124:source\asw/sound.c **** /**
 125:source\asw/sound.c ****  * Set the song. This song will be played in an endless loop
 126:source\asw/sound.c ****  * /param   uint8_t const *const song       : pointer to the song data [IN]
 127:source\asw/sound.c ****  * /param   uint32_t sizeOfSong             : size of the song data [IN]
 128:source\asw/sound.c ****  * /return RC_SUCCESS
 129:source\asw/sound.c ****  */
 130:source\asw/sound.c **** RC_t SOUND_SetSong(uint8_t const *const song, uint32_t sizeOfSong)
 131:source\asw/sound.c **** {
 132:source\asw/sound.c ****     /* Disable dual buffer path */
 133:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf = 0;
 134:source\asw/sound.c **** 
 135:source\asw/sound.c ****     /* Set flash path */
 136:source\asw/sound.c ****     SOUND__currentSong.m_song = song;
 137:source\asw/sound.c ****     SOUND__currentSong.m_size = sizeOfSong;
 138:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 139:source\asw/sound.c **** 
 140:source\asw/sound.c ****     return RC_SUCCESS;
 141:source\asw/sound.c **** }
 142:source\asw/sound.c **** 
 143:source\asw/sound.c **** /**
 144:source\asw/sound.c ****  * Set the volume
 145:source\asw/sound.c ****  * /param   uint8_t volume                 : volume in % 0...100
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc7u6LU4.s 			page 4


 146:source\asw/sound.c ****  * /return RC_SUCCESS
 147:source\asw/sound.c ****  */
 148:source\asw/sound.c **** RC_t SOUND_SetVolume(uint8_t volume)
 149:source\asw/sound.c **** {
 150:source\asw/sound.c ****     if (volume > 100) volume = 100;
 151:source\asw/sound.c ****     
 152:source\asw/sound.c ****     SOUND__currentSong.m_volume = volume;
 153:source\asw/sound.c ****     
 154:source\asw/sound.c ****     return RC_SUCCESS;
 155:source\asw/sound.c **** }
 156:source\asw/sound.c **** 
 157:source\asw/sound.c **** RC_t SOUND_FillBuffer(uint8_t const * const data, uint16_t size)
 158:source\asw/sound.c **** {
 159:source\asw/sound.c ****     uint16_t i;
 160:source\asw/sound.c **** 
 161:source\asw/sound.c ****     if ((size == 0u) || (size > SOUND_BUFFER_SIZE))
 162:source\asw/sound.c ****     {
 163:source\asw/sound.c ****         return RC_ERROR;
 164:source\asw/sound.c ****     }
 165:source\asw/sound.c **** 
 166:source\asw/sound.c ****     /* Switch to dual buffer mode if not already */
 167:source\asw/sound.c ****     if (SOUND__currentSong.m_activeBuf == 0)
 168:source\asw/sound.c ****     {
 169:source\asw/sound.c ****         SOUND__currentSong.m_activeBuf   = SOUND__bufA;
 170:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf = SOUND__bufB;
 171:source\asw/sound.c ****         SOUND__currentSong.m_readPos     = 0u;
 172:source\asw/sound.c ****         SOUND__currentSong.m_activeFill  = 0u;
 173:source\asw/sound.c ****     }
 174:source\asw/sound.c **** 
 175:source\asw/sound.c ****     /* Write into inactive buffer — ISR never touches this one */
 176:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf = SOUND__GetInactiveBuf();
 177:source\asw/sound.c **** 
 178:source\asw/sound.c ****     for (i = 0u; i < size; i++)
 179:source\asw/sound.c ****     {
 180:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = data[i];
 181:source\asw/sound.c ****     }
 182:source\asw/sound.c **** 
 183:source\asw/sound.c ****     /* Pad remainder with silence for partial last buffer */
 184:source\asw/sound.c ****     for (i = size; i < SOUND_BUFFER_SIZE; i++)
 185:source\asw/sound.c ****     {
 186:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = SOUND_SILENCE;
 187:source\asw/sound.c ****     }
 188:source\asw/sound.c **** 
 189:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = size;
 190:source\asw/sound.c **** 
 191:source\asw/sound.c ****     return RC_SUCCESS;
 192:source\asw/sound.c **** }
 193:source\asw/sound.c **** 
 194:source\asw/sound.c **** RC_t SOUND_SwapBuffers()
 195:source\asw/sound.c **** {
 196:source\asw/sound.c ****     volatile uint8_t * tmpBuf;
 197:source\asw/sound.c **** 
 198:source\asw/sound.c ****     /* Single pointer swap — atomic on Cortex-M3 */
 199:source\asw/sound.c ****     tmpBuf                            = SOUND__currentSong.m_activeBuf;
 200:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__currentSong.m_inactiveBuf;
 201:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = tmpBuf;
 202:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND__currentSong.m_inactiveFill;
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc7u6LU4.s 			page 5


 203:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 204:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 205:source\asw/sound.c **** 
 206:source\asw/sound.c ****     return RC_SUCCESS;
 207:source\asw/sound.c **** }
