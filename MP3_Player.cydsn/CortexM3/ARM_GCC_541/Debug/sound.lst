  50:source\asw/sound.c **** /**
  51:source\asw/sound.c ****  * \brief State of the driver, shared between tsk_reader and the timer ISR (N1, N2).
  52:source\asw/sound.c ****  *
  53:source\asw/sound.c ****  * The pointers are volatile themselves ("uint8_t * volatile"), the buffer bytes
  54:source\asw/sound.c ****  * are plain data: a buffer is only touched by one side at a time (N2).
  55:source\asw/sound.c ****  */
  56:source\asw/sound.c **** typedef struct
  57:source\asw/sound.c **** {
  58:source\asw/sound.c ****     uint8_t const *    m_song;          /**< Legacy flash path: song data, stored only (N6)        
  59:source\asw/sound.c ****     uint32_t           m_size;          /**< Legacy flash path: size, stored only (N6)             
  60:source\asw/sound.c ****     uint32_t           m_pos;           /**< Legacy flash path: position, stored only (N6)         
  61:source\asw/sound.c ****     uint8_t * volatile m_activeBuf;     /**< buffer played by the ISR, NULL = dual buffer path off 
  62:source\asw/sound.c ****     uint8_t * volatile m_inactiveBuf;   /**< buffer filled by the reader                           
  63:source\asw/sound.c ****     volatile uint16_t  m_activeFill;    /**< valid samples in the active buffer                    
  64:source\asw/sound.c ****     volatile uint16_t  m_inactiveFill;  /**< valid samples in the inactive buffer, 0 = empty / not 
  65:source\asw/sound.c ****     volatile uint16_t  m_readPos;       /**< next sample of the active buffer that the ISR outputs 
  66:source\asw/sound.c ****     volatile uint8_t   m_volume;        /**< volume in percent 0..SOUND_VOLUME_MAX                 
  67:source\asw/sound.c **** } SOUND__Driver_t;
  68:source\asw/sound.c **** 
  69:source\asw/sound.c **** /*****************************************************************************/
