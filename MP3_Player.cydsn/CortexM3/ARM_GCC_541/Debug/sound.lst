  70:source\asw/sound.c **** RC_t SOUND_Init()
  71:source\asw/sound.c **** {
  72:source\asw/sound.c ****     /* Pre-fill both buffers with silence - no click on start */
  73:source\asw/sound.c ****     memset(SOUND__bufA, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  74:source\asw/sound.c ****     memset(SOUND__bufB, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  75:source\asw/sound.c **** 
  76:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
  77:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
  78:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
  79:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
  80:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
  81:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
  82:source\asw/sound.c **** 
  83:source\asw/sound.c ****     /* Flash path: cleared */
  84:source\asw/sound.c ****     SOUND__currentSong.m_song = 0;
  85:source\asw/sound.c ****     SOUND__currentSong.m_size = 0;
  86:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0;
  87:source\asw/sound.c **** 
  88:source\asw/sound.c ****     /* Hardware init */
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc7u6LU4.s 			page 3


  89:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
  90:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
  91:source\asw/sound.c ****     SOUND_StopPlay();
  92:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
  93:source\asw/sound.c ****     SOUND_PWM_Start();
  94:source\asw/sound.c ****     SOUND_PWM_WriteCompare(SOUND_SILENCE);
  95:source\asw/sound.c **** 
  96:source\asw/sound.c ****     return RC_SUCCESS;
  97:source\asw/sound.c **** }
