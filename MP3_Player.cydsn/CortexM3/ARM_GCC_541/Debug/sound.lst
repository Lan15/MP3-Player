 134:source\asw/sound.c **** 
 135:source\asw/sound.c **** RC_t SOUND_Init()
 136:source\asw/sound.c **** {
 137:source\asw/sound.c ****     /* Pre-fill both buffers with silence — no click on start */
 138:source\asw/sound.c ****     memset(SOUND__bufA, SOUND_SILENCE, SOUND_BUFFER_SIZE);
 139:source\asw/sound.c ****     memset(SOUND__bufB, SOUND_SILENCE, SOUND_BUFFER_SIZE);
 140:source\asw/sound.c **** 
 141:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
 142:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
 143:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
 144:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
 145:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 146:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 147:source\asw/sound.c **** 
 148:source\asw/sound.c ****     /* Flash path: cleared */
 149:source\asw/sound.c ****     SOUND__currentSong.m_song = 0;
 150:source\asw/sound.c ****     SOUND__currentSong.m_size = 0;
 151:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0;
 152:source\asw/sound.c **** 
 153:source\asw/sound.c ****     /* Hardware init */
 154:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
 155:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
 156:source\asw/sound.c ****     SOUND_StopPlay();
 157:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
 158:source\asw/sound.c ****     SOUND_PWM_Start();
 159:source\asw/sound.c ****     SOUND_PWM_WriteCompare(SOUND_SILENCE);
 160:source\asw/sound.c **** 
 161:source\asw/sound.c ****     return RC_SUCCESS;
 162:source\asw/sound.c **** }
