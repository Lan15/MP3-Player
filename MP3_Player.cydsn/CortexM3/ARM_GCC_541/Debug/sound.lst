  79:source\asw/sound.c **** RC_t SOUND_Init()
  80:source\asw/sound.c **** {
  81:source\asw/sound.c ****     /* Pre-fill both buffers with silence - no click on start */
  82:source\asw/sound.c ****     memset(SOUND__bufA, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  83:source\asw/sound.c ****     memset(SOUND__bufB, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  84:source\asw/sound.c **** 
  85:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
  86:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
  87:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
  88:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
