  93:source\asw/sound.c **** /**
  94:source\asw/sound.c ****  * \brief Initialise the driver and the PWM / VDAC hardware (called once from tsk_init).
  95:source\asw/sound.c ****  *
  96:source\asw/sound.c ****  * Fills both buffers with silence, selects A as active and B as inactive buffer,
  97:source\asw/sound.c ****  * clears the legacy flash fields (N6), routes channel 1, enables the output stage,
  98:source\asw/sound.c ****  * keeps the sample clock stopped and sets the PWM to the silence level.
  99:source\asw/sound.c ****  * The volume is not touched (default SOUND_VOLUME_MAX).
 100:source\asw/sound.c ****  *
 101:source\asw/sound.c ****  * \return RC_SUCCESS (always)
 102:source\asw/sound.c ****  */
 103:source\asw/sound.c **** RC_t SOUND_Init(void)
 104:source\asw/sound.c **** {
 105:source\asw/sound.c ****     /* Pre-fill both buffers with silence - no click on start */
 106:source\asw/sound.c ****     (void)memset(SOUND__bufA, (int)SOUND_SILENCE, SOUND_BUFFER_SIZE);
 107:source\asw/sound.c ****     (void)memset(SOUND__bufB, (int)SOUND_SILENCE, SOUND_BUFFER_SIZE);
 108:source\asw/sound.c **** 
 109:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
 110:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
 111:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
 112:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
 113:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 114:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 115:source\asw/sound.c **** 
 116:source\asw/sound.c ****     /* Flash path: cleared */
 117:source\asw/sound.c ****     SOUND__currentSong.m_song = NULL;
 118:source\asw/sound.c ****     SOUND__currentSong.m_size = 0u;
 119:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 120:source\asw/sound.c **** 
 121:source\asw/sound.c ****     /* Hardware init */
 122:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
 123:source\asw/sound.c ****     SOUND_ENABLE_Write(1u);
 124:source\asw/sound.c ****     (void)SOUND_StopPlay();
 125:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
 126:source\asw/sound.c ****     SOUND_PWM_Start();
 127:source\asw/sound.c ****     SOUND_PWM_WriteCompare(SOUND_SILENCE);
 128:source\asw/sound.c **** 
 129:source\asw/sound.c ****     return RC_SUCCESS;
 130:source\asw/sound.c **** }
 131:source\asw/sound.c **** 
 132:source\asw/sound.c **** /**
 133:source\asw/sound.c ****  * \brief Start the sample clock; the timer ISR then calls SOUND_isr() every tick.
 134:source\asw/sound.c ****  * \return RC_SUCCESS (always)
 135:source\asw/sound.c ****  */
 136:source\asw/sound.c **** RC_t SOUND_StartPlay(void)
 137:source\asw/sound.c **** {
 138:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Start();
 139:source\asw/sound.c **** 
 140:source\asw/sound.c ****     return RC_SUCCESS;
 141:source\asw/sound.c **** }
 142:source\asw/sound.c **** 
 143:source\asw/sound.c **** /**
 144:source\asw/sound.c ****  * \brief Stop the sample clock; SOUND_isr() is no longer called, the PWM holds its last value.
 145:source\asw/sound.c ****  * \return RC_SUCCESS (always)
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccf79qVL.s 			page 4


 146:source\asw/sound.c ****  */
 147:source\asw/sound.c **** RC_t SOUND_StopPlay(void)
 148:source\asw/sound.c **** {
 149:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Stop();      /* isr_Timer_Disable() does not work, the clock is stopped inst
 150:source\asw/sound.c **** 
 151:source\asw/sound.c **** 	//isr_Timer_Disable seems not to work
 152:source\asw/sound.c ****     //isr_Timer_Disable();
 153:source\asw/sound.c **** 
 154:source\asw/sound.c ****     return RC_SUCCESS;
 155:source\asw/sound.c **** }
 156:source\asw/sound.c **** 
 157:source\asw/sound.c **** /**
 158:source\asw/sound.c ****  * \brief Set a song in flash (old flash player, no longer played, N6 in sound.c).
 159:source\asw/sound.c ****  *
 160:source\asw/sound.c ****  * Switches the dual buffer path off: the ISR outputs nothing until the next
 161:source\asw/sound.c ****  * SOUND_FillBuffer() call.
 162:source\asw/sound.c ****  *
 163:source\asw/sound.c ****  * /param   uint8_t const *const song       : pointer to the song data [IN]
 164:source\asw/sound.c ****  * /param   uint32_t sizeOfSong             : size of the song data [IN]
 165:source\asw/sound.c ****  * \return RC_SUCCESS always
 166:source\asw/sound.c ****  */
 167:source\asw/sound.c **** RC_t SOUND_SetSong(uint8_t const * const song, uint32_t const sizeOfSong)
 168:source\asw/sound.c **** {
 169:source\asw/sound.c ****     /* Disable dual buffer path */
 170:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf = NULL;
 171:source\asw/sound.c **** 
 172:source\asw/sound.c ****     /* Set flash path (stored only, N6) */
 173:source\asw/sound.c ****     SOUND__currentSong.m_song = song;
 174:source\asw/sound.c ****     SOUND__currentSong.m_size = sizeOfSong;
 175:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 176:source\asw/sound.c **** 
 177:source\asw/sound.c ****     return RC_SUCCESS;
 178:source\asw/sound.c **** }
 179:source\asw/sound.c **** 
 180:source\asw/sound.c **** /**
 181:source\asw/sound.c ****  * \brief Set the volume.
 182:source\asw/sound.c ****  * /param   uint8_t volume                  : volume in percent, 0..#SOUND_VOLUME_MAX; larger value
 183:source\asw/sound.c ****  * \return RC_SUCCESS always
 184:source\asw/sound.c ****  */
 185:source\asw/sound.c **** RC_t SOUND_SetVolume(uint8_t const volume)
 186:source\asw/sound.c **** {
 187:source\asw/sound.c ****     uint8_t vol = volume;
 188:source\asw/sound.c **** 
 189:source\asw/sound.c ****     if (vol > SOUND_VOLUME_MAX)
 190:source\asw/sound.c ****     {
 191:source\asw/sound.c ****         vol = (uint8_t)SOUND_VOLUME_MAX;
 192:source\asw/sound.c ****     }
 193:source\asw/sound.c **** 
 194:source\asw/sound.c ****     SOUND__currentSong.m_volume = vol;
 195:source\asw/sound.c **** 
 196:source\asw/sound.c ****     return RC_SUCCESS;
 197:source\asw/sound.c **** }
 198:source\asw/sound.c **** 
 199:source\asw/sound.c **** /**
 200:source\asw/sound.c ****  * \brief Copy PCM data into the inactive buffer and announce it to the ISR (N1, N2, N5).
 201:source\asw/sound.c ****  *
 202:source\asw/sound.c ****  * The rest of the buffer is padded with SOUND_SILENCE. m_inactiveFill is set last;
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccf79qVL.s 			page 5


 203:source\asw/sound.c ****  * only then may the ISR swap. Switches the dual buffer path on if SOUND_SetSong()
 204:source\asw/sound.c ****  * had switched it off.
 205:source\asw/sound.c ****  *
 206:source\asw/sound.c ****  * \param[in] data  PCM bytes, at least size bytes, must not overlap the driver buffers
 207:source\asw/sound.c ****  * \param[in] size  Number of valid bytes, 1..SOUND_BUFFER_SIZE
 208:source\asw/sound.c ****  * \return RC_SUCCESS, or RC_ERROR if size is 0 or larger than SOUND_BUFFER_SIZE (nothing is change
 209:source\asw/sound.c ****  */
 210:source\asw/sound.c **** RC_t SOUND_FillBuffer(uint8_t const * const data, uint16_t const size)
 211:source\asw/sound.c **** {
 212:source\asw/sound.c ****     RC_t rc = RC_ERROR;
 213:source\asw/sound.c **** 
 214:source\asw/sound.c ****     if ((size != 0u) && (size <= SOUND_BUFFER_SIZE))
 215:source\asw/sound.c ****     {
 216:source\asw/sound.c ****         uint8_t * dst;
 217:source\asw/sound.c **** 
 218:source\asw/sound.c ****         /* Switch to dual buffer mode if not already */
 219:source\asw/sound.c ****         if (SOUND__currentSong.m_activeBuf == NULL)
 220:source\asw/sound.c ****         {
 221:source\asw/sound.c ****             SOUND__currentSong.m_activeBuf   = SOUND__bufA;
 222:source\asw/sound.c ****             SOUND__currentSong.m_inactiveBuf = SOUND__bufB;
 223:source\asw/sound.c ****             SOUND__currentSong.m_readPos     = 0u;
 224:source\asw/sound.c ****             SOUND__currentSong.m_activeFill  = 0u;
 225:source\asw/sound.c ****         }
 226:source\asw/sound.c **** 
 227:source\asw/sound.c ****         /* Write into the inactive buffer - the ISR never touches this one (N1) */
 228:source\asw/sound.c ****         dst = SOUND__GetInactiveBuf();
 229:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf = dst;
 230:source\asw/sound.c **** 
 231:source\asw/sound.c ****         (void)memcpy(dst, data, size);                                              /* N5: block co
 232:source\asw/sound.c ****         (void)memset(&dst[size], (int)SOUND_SILENCE, (size_t)SOUND_BUFFER_SIZE - size);   /* pad th
 233:source\asw/sound.c **** 
 234:source\asw/sound.c ****         SOUND__CompilerBarrier();                       /* N2: all bytes are written before the buf
 235:source\asw/sound.c ****         SOUND__currentSong.m_inactiveFill = size;       /* last step: now the ISR may swap */
 236:source\asw/sound.c **** 
 237:source\asw/sound.c ****         rc = RC_SUCCESS;
 238:source\asw/sound.c ****     }
 239:source\asw/sound.c **** 
 240:source\asw/sound.c ****     return rc;
 241:source\asw/sound.c **** }
 242:source\asw/sound.c **** 
 243:source\asw/sound.c **** /**
 244:source\asw/sound.c ****  * \brief Exchange active and inactive buffer (N1).
 245:source\asw/sound.c ****  *
 246:source\asw/sound.c ****  * The new active buffer gets the fill level of the former inactive one, the new
 247:source\asw/sound.c ****  * inactive buffer is marked empty and the read position restarts at 0.
 248:source\asw/sound.c ****  * Called from SOUND_isr() when the active buffer is finished and the inactive one
 249:source\asw/sound.c ****  * is ready, and once from the reader at start-up. Must not run in parallel with the ISR.
 250:source\asw/sound.c ****  *
 251:source\asw/sound.c ****  * \return RC_SUCCESS (always)
 252:source\asw/sound.c ****  */
 253:source\asw/sound.c **** RC_t SOUND_SwapBuffers(void)
 254:source\asw/sound.c **** {
 255:source\asw/sound.c ****     uint8_t * tmpBuf;
 256:source\asw/sound.c **** 
 257:source\asw/sound.c ****     /* Swap the pointers and take over the fill level. In the ISR this cannot be
 258:source\asw/sound.c ****        interrupted by the reader (N1). */
 259:source\asw/sound.c ****     tmpBuf                            = SOUND__currentSong.m_activeBuf;
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccf79qVL.s 			page 6


 260:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__currentSong.m_inactiveBuf;
 261:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = tmpBuf;
 262:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND__currentSong.m_inactiveFill;
 263:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 264:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 265:source\asw/sound.c **** 
 266:source\asw/sound.c ****     return RC_SUCCESS;
 267:source\asw/sound.c **** }
 268:source\asw/sound.c **** 
 269:source\asw/sound.c **** /**
 270:source\asw/sound.c ****  * \brief Return the number of underrun ticks since the last call and reset the counter (N7).
 271:source\asw/sound.c ****  *
 272:source\asw/sound.c ****  * An underrun is a tick where the active buffer was finished and no new one was ready.
 273:source\asw/sound.c ****  *
 274:source\asw/sound.c ****  * \return Number of ISR ticks without a new sample, 0..UINT32_MAX
 275:source\asw/sound.c ****  */
 276:source\asw/sound.c **** uint32_t SOUND__GetAndClearUnderruns(void)
 277:source\asw/sound.c **** {
 278:source\asw/sound.c ****     uint32_t const n = SOUND__underruns;
 279:source\asw/sound.c **** 
 280:source\asw/sound.c ****     SOUND__underruns = 0u;                      /* N7: a tick between the two lines is lost */
 281:source\asw/sound.c ****     return n;
 282:source\asw/sound.c **** }
 283:source\asw/sound.c **** 
