  75:source\asw/sound.c **** static uint8_t SOUND__bufB[SOUND_BUFFER_SIZE];
  76:source\asw/sound.c **** 
  77:source\asw/sound.c **** static SOUND__Driver_t SOUND__currentSong = {NULL, 0u, 0u, NULL, NULL, 0u, 0u, 0u, SOUND_VOLUME_MAX
  78:source\asw/sound.c **** 
  79:source\asw/sound.c **** 
  80:source\asw/sound.c **** static volatile uint32_t SOUND__underruns = 0u;	/**< \brief ticks where no sample was ready (N7). *
