  72:source\asw/sound.c **** RC_t SOUND_Init()
  73:source\asw/sound.c **** {
  74:source\asw/sound.c ****     /* Pre-fill both buffers with silence - no click on start */
  75:source\asw/sound.c ****     memset(SOUND__bufA, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  76:source\asw/sound.c ****     memset(SOUND__bufB, SOUND_SILENCE, SOUND_BUFFER_SIZE);
  77:source\asw/sound.c **** 
  78:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
  79:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
  80:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
  81:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
  82:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
  83:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
  84:source\asw/sound.c **** 
  85:source\asw/sound.c ****     /* Flash path: cleared */
  86:source\asw/sound.c ****     SOUND__currentSong.m_song = 0;
  87:source\asw/sound.c ****     SOUND__currentSong.m_size = 0;
  88:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0;
