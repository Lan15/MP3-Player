 101:source\asw/sound.c **** /**
 102:source\asw/sound.c ****  * Activate the Timer ISR for playing a song
 103:source\asw/sound.c ****  * /return RC_SUCCESS
 104:source\asw/sound.c ****  */
 105:source\asw/sound.c **** RC_t SOUND_StartPlay()
 106:source\asw/sound.c **** {
 107:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Start();
 108:source\asw/sound.c ****     
 109:source\asw/sound.c ****     return RC_SUCCESS;
 110:source\asw/sound.c **** }
 111:source\asw/sound.c **** 
 112:source\asw/sound.c **** /**
 113:source\asw/sound.c ****  * DeActivate the Timer ISR for playing a song
 114:source\asw/sound.c ****  * /return RC_SUCCESS
 115:source\asw/sound.c ****  */
 116:source\asw/sound.c **** RC_t SOUND_StopPlay()
 117:source\asw/sound.c **** {
 118:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Stop();
 119:source\asw/sound.c ****     
 120:source\asw/sound.c ****     //isr_Timer_Disable seems not to work
 121:source\asw/sound.c ****     //isr_Timer_Disable();
 122:source\asw/sound.c ****     
 123:source\asw/sound.c ****     return RC_SUCCESS;
 124:source\asw/sound.c **** }
 125:source\asw/sound.c **** 
 126:source\asw/sound.c **** /**
 127:source\asw/sound.c ****  * Set the song. This song will be played in an endless loop
 128:source\asw/sound.c ****  * /param   uint8_t const *const song       : pointer to the song data [IN]
 129:source\asw/sound.c ****  * /param   uint32_t sizeOfSong             : size of the song data [IN]
 130:source\asw/sound.c ****  * /return RC_SUCCESS
 131:source\asw/sound.c ****  */
 132:source\asw/sound.c **** RC_t SOUND_SetSong(uint8_t const *const song, uint32_t sizeOfSong)
 133:source\asw/sound.c **** {
 134:source\asw/sound.c ****     /* Disable dual buffer path */
 135:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf = 0;
 136:source\asw/sound.c **** 
 137:source\asw/sound.c ****     /* Set flash path */
 138:source\asw/sound.c ****     SOUND__currentSong.m_song = song;
 139:source\asw/sound.c ****     SOUND__currentSong.m_size = sizeOfSong;
 140:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 141:source\asw/sound.c **** 
 142:source\asw/sound.c ****     return RC_SUCCESS;
 143:source\asw/sound.c **** }
 144:source\asw/sound.c **** 
 145:source\asw/sound.c **** /**
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc75YkOK.s 			page 4


 146:source\asw/sound.c ****  * Set the volume
 147:source\asw/sound.c ****  * /param   uint8_t volume                 : volume in % 0...100
 148:source\asw/sound.c ****  * /return RC_SUCCESS
 149:source\asw/sound.c ****  */
 150:source\asw/sound.c **** RC_t SOUND_SetVolume(uint8_t volume)
 151:source\asw/sound.c **** {
 152:source\asw/sound.c ****     if (volume > 100) volume = 100;
 153:source\asw/sound.c ****     
 154:source\asw/sound.c ****     SOUND__currentSong.m_volume = volume;
 155:source\asw/sound.c ****     
 156:source\asw/sound.c ****     return RC_SUCCESS;
 157:source\asw/sound.c **** }
 158:source\asw/sound.c **** 
 159:source\asw/sound.c **** RC_t SOUND_FillBuffer(uint8_t const * const data, uint16_t size)
 160:source\asw/sound.c **** {
 161:source\asw/sound.c ****     uint16_t i;
 162:source\asw/sound.c **** 
 163:source\asw/sound.c ****     if ((size == 0u) || (size > SOUND_BUFFER_SIZE))
 164:source\asw/sound.c ****     {
 165:source\asw/sound.c ****         return RC_ERROR;
 166:source\asw/sound.c ****     }
 167:source\asw/sound.c **** 
 168:source\asw/sound.c ****     /* Switch to dual buffer mode if not already */
 169:source\asw/sound.c ****     if (SOUND__currentSong.m_activeBuf == 0)
 170:source\asw/sound.c ****     {
 171:source\asw/sound.c ****         SOUND__currentSong.m_activeBuf   = SOUND__bufA;
 172:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf = SOUND__bufB;
 173:source\asw/sound.c ****         SOUND__currentSong.m_readPos     = 0u;
 174:source\asw/sound.c ****         SOUND__currentSong.m_activeFill  = 0u;
 175:source\asw/sound.c ****     }
 176:source\asw/sound.c **** 
 177:source\asw/sound.c ****     /* Write into inactive buffer — ISR never touches this one */
 178:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf = SOUND__GetInactiveBuf();
 179:source\asw/sound.c **** 
 180:source\asw/sound.c ****     for (i = 0u; i < size; i++)
 181:source\asw/sound.c ****     {
 182:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = data[i];
 183:source\asw/sound.c ****     }
 184:source\asw/sound.c **** 
 185:source\asw/sound.c ****     /* Pad remainder with silence for partial last buffer */
 186:source\asw/sound.c ****     for (i = size; i < SOUND_BUFFER_SIZE; i++)
 187:source\asw/sound.c ****     {
 188:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = SOUND_SILENCE;
 189:source\asw/sound.c ****     }
 190:source\asw/sound.c **** 
 191:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = size;
 192:source\asw/sound.c **** 
 193:source\asw/sound.c ****     return RC_SUCCESS;
 194:source\asw/sound.c **** }
 195:source\asw/sound.c **** 
 196:source\asw/sound.c **** RC_t SOUND_SwapBuffers()
 197:source\asw/sound.c **** {
 198:source\asw/sound.c ****     volatile uint8_t * tmpBuf;
 199:source\asw/sound.c **** 
 200:source\asw/sound.c ****     /* Single pointer swap — atomic on Cortex-M3 */
 201:source\asw/sound.c ****     tmpBuf                            = SOUND__currentSong.m_activeBuf;
 202:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__currentSong.m_inactiveBuf;
ARM GAS  C:\Users\agila\AppData\Local\Temp\cc75YkOK.s 			page 5


 203:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = tmpBuf;
 204:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND__currentSong.m_inactiveFill;
 205:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 206:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 207:source\asw/sound.c **** 
 208:source\asw/sound.c ****     return RC_SUCCESS;
 209:source\asw/sound.c **** }
