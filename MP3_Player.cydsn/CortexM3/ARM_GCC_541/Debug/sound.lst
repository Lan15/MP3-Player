 131:source\asw/sound.c **** }
 132:source\asw/sound.c **** 
 133:source\asw/sound.c **** /**
 134:source\asw/sound.c ****  * Set the song. This song will be played in an endless loop
 135:source\asw/sound.c ****  * /param   uint8_t const *const song       : pointer to the song data [IN]
 136:source\asw/sound.c ****  * /param   uint32_t sizeOfSong             : size of the song data [IN]
 137:source\asw/sound.c ****  * /return RC_SUCCESS
 138:source\asw/sound.c ****  */
 139:source\asw/sound.c **** RC_t SOUND_SetSong(uint8_t const *const song, uint32_t sizeOfSong)
 140:source\asw/sound.c **** {
 141:source\asw/sound.c ****     /* Disable dual buffer path */
 142:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf = 0;
 143:source\asw/sound.c **** 
 144:source\asw/sound.c ****     /* Set flash path */
 145:source\asw/sound.c ****     SOUND__currentSong.m_song = song;
ARM GAS  C:\Users\agila\AppData\Local\Temp\cclC4Ze3.s 			page 4


 146:source\asw/sound.c ****     SOUND__currentSong.m_size = sizeOfSong;
 147:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 148:source\asw/sound.c **** 
 149:source\asw/sound.c ****     return RC_SUCCESS;
 150:source\asw/sound.c **** }
 151:source\asw/sound.c **** 
 152:source\asw/sound.c **** /**
 153:source\asw/sound.c ****  * Set the volume
 154:source\asw/sound.c ****  * /param   uint8_t volume                 : volume in % 0...100
 155:source\asw/sound.c ****  * /return RC_SUCCESS
 156:source\asw/sound.c ****  */
 157:source\asw/sound.c **** RC_t SOUND_SetVolume(uint8_t volume)
 158:source\asw/sound.c **** {
 159:source\asw/sound.c ****     if (volume > 100) volume = 100;
 160:source\asw/sound.c ****     
 161:source\asw/sound.c ****     SOUND__currentSong.m_volume = volume;
 162:source\asw/sound.c ****     
 163:source\asw/sound.c ****     return RC_SUCCESS;
 164:source\asw/sound.c **** }
 165:source\asw/sound.c **** 
 166:source\asw/sound.c **** RC_t SOUND_FillBuffer(uint8_t const * const data, uint16_t size)
 167:source\asw/sound.c **** {
 168:source\asw/sound.c ****     uint16_t i;
 169:source\asw/sound.c **** 
 170:source\asw/sound.c ****     if ((size == 0u) || (size > SOUND_BUFFER_SIZE))
 171:source\asw/sound.c ****     {
 172:source\asw/sound.c ****         return RC_ERROR;
 173:source\asw/sound.c ****     }
 174:source\asw/sound.c **** 
 175:source\asw/sound.c ****     /* Switch to dual buffer mode if not already */
 176:source\asw/sound.c ****     if (SOUND__currentSong.m_activeBuf == 0)
 177:source\asw/sound.c ****     {
 178:source\asw/sound.c ****         SOUND__currentSong.m_activeBuf   = SOUND__bufA;
 179:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf = SOUND__bufB;
 180:source\asw/sound.c ****         SOUND__currentSong.m_readPos     = 0u;
 181:source\asw/sound.c ****         SOUND__currentSong.m_activeFill  = 0u;
 182:source\asw/sound.c ****     }
 183:source\asw/sound.c **** 
 184:source\asw/sound.c ****     /* Write into inactive buffer — ISR never touches this one */
 185:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf = SOUND__GetInactiveBuf();
 186:source\asw/sound.c **** 
 187:source\asw/sound.c ****     for (i = 0u; i < size; i++)
 188:source\asw/sound.c ****     {
 189:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = data[i];
 190:source\asw/sound.c ****     }
 191:source\asw/sound.c **** 
 192:source\asw/sound.c ****     /* Pad remainder with silence for partial last buffer */
 193:source\asw/sound.c ****     for (i = size; i < SOUND_BUFFER_SIZE; i++)
 194:source\asw/sound.c ****     {
 195:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf[i] = SOUND_SILENCE;
 196:source\asw/sound.c ****     }
 197:source\asw/sound.c **** 
 198:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = size;
 199:source\asw/sound.c **** 
 200:source\asw/sound.c ****     return RC_SUCCESS;
 201:source\asw/sound.c **** }
 202:source\asw/sound.c **** 
ARM GAS  C:\Users\agila\AppData\Local\Temp\cclC4Ze3.s 			page 5


 203:source\asw/sound.c **** RC_t SOUND_SwapBuffers()
 204:source\asw/sound.c **** {
 205:source\asw/sound.c ****     volatile uint8_t * tmpBuf;
 206:source\asw/sound.c **** 
 207:source\asw/sound.c ****     /* Single pointer swap — atomic on Cortex-M3 */
 208:source\asw/sound.c ****     tmpBuf                            = SOUND__currentSong.m_activeBuf;
 209:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__currentSong.m_inactiveBuf;
 210:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = tmpBuf;
 211:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND__currentSong.m_inactiveFill;
 212:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 213:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 214:source\asw/sound.c **** 
 215:source\asw/sound.c ****     return RC_SUCCESS;
 216:source\asw/sound.c **** }
