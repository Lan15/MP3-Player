  59:source\asw/sound.c **** /**
  60:source\asw/sound.c ****  * Init Function for the sound driver
  61:source\asw/sound.c ****  * /return RC_SUCCESS
  62:source\asw/sound.c ****  */
  63:source\asw/sound.c **** RC_t SOUND_Init()
  64:source\asw/sound.c **** {
  65:source\asw/sound.c ****     //Set the MUX to channel 1
  66:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
  67:source\asw/sound.c ****     
  68:source\asw/sound.c ****     //Enable power supply
  69:source\asw/sound.c ****     SOUND_ENABLE_Write(1);
  70:source\asw/sound.c **** 
  71:source\asw/sound.c ****     //Disable the song sample timer
  72:source\asw/sound.c ****     SOUND_StopPlay();
  73:source\asw/sound.c **** 
  74:source\asw/sound.c ****     //Initialize PWM and Clock
  75:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
  76:source\asw/sound.c ****     SOUND_PWM_Start();
  77:source\asw/sound.c ****     SOUND_PWM_WriteCompare(0);
  78:source\asw/sound.c ****     
  79:source\asw/sound.c ****     
  80:source\asw/sound.c ****     return RC_SUCCESS;
  81:source\asw/sound.c **** }
