  99:source\asw/sound.c **** /**
 100:source\asw/sound.c ****  * Activate the Timer ISR for playing a song
 101:source\asw/sound.c ****  * /return RC_SUCCESS
 102:source\asw/sound.c ****  */
 103:source\asw/sound.c **** RC_t SOUND_StartPlay()
 104:source\asw/sound.c **** {
 105:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Start();
