  37:Libraries\FatFs_Library/sdcard.c ****        Example: 
  38:Libraries\FatFs_Library/sdcard.c ****         - if using Cypress API macros: SPI_ss0_m_Write
  39:Libraries\FatFs_Library/sdcard.c ****         - if using another gpio pint: SPI_SS_Write. */
  40:Libraries\FatFs_Library/sdcard.c **** //#define mmSPI_SS_Write(value)   SPI_ss0_m_Write(value)
  41:Libraries\FatFs_Library/sdcard.c **** #define mmSPI_SS_Write(value)     SPI_SS_Write(value)        
  42:Libraries\FatFs_Library/sdcard.c **** 
