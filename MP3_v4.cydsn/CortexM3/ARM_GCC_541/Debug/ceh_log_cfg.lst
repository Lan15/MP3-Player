 111:source\bsw\Services\ceh/ceh_log_cfg.c ****  * \param uint32_t data			: [IN] Possible payload
 112:source\bsw\Services\ceh/ceh_log_cfg.c ****  * \param uint32_t currTime		: [IN] Timestamp in ms
 113:source\bsw\Services\ceh/ceh_log_cfg.c ****  * \return RC_t 				: [OUT] Status of the sending
 114:source\bsw\Services\ceh/ceh_log_cfg.c ****  */
 115:source\bsw\Services\ceh/ceh_log_cfg.c **** RC_t CEH_UART_send(CEH_event_t event, uint32_t data, uint32_t currTime)
 116:source\bsw\Services\ceh/ceh_log_cfg.c **** {
 117:source\bsw\Services\ceh/ceh_log_cfg.c **** 	// user defined function
 118:source\bsw\Services\ceh/ceh_log_cfg.c **** 	RC_t ret = RC_SUCCESS;
 119:source\bsw\Services\ceh/ceh_log_cfg.c **** 
 120:source\bsw\Services\ceh/ceh_log_cfg.c **** 	// Construct the error message
 121:source\bsw\Services\ceh/ceh_log_cfg.c **** 	char errMsg[CEH_STR_BUFF_SIZE];
 122:source\bsw\Services\ceh/ceh_log_cfg.c **** 	ret = CEH__formatErrMsg(event, data, currTime, errMsg, CEH_STR_BUFF_SIZE);
 123:source\bsw\Services\ceh/ceh_log_cfg.c **** 	if (RC_SUCCESS != ret) return ret;
 124:source\bsw\Services\ceh/ceh_log_cfg.c **** 
 125:source\bsw\Services\ceh/ceh_log_cfg.c **** 	// Call driver function to send the packet
 126:source\bsw\Services\ceh/ceh_log_cfg.c **** 	UART_LOG_PutString(errMsg);
 127:source\bsw\Services\ceh/ceh_log_cfg.c **** 
 128:source\bsw\Services\ceh/ceh_log_cfg.c **** 	return ret;
 129:source\bsw\Services\ceh/ceh_log_cfg.c **** }
