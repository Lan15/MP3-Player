  90:source\asw/sound.c **** /**
  91:source\asw/sound.c ****  * \brief Initialise the sound driver and the PWM / VDAC hardware (called once from tsk_init).
  92:source\asw/sound.c ****  *
  93:source\asw/sound.c ****  * Fills both buffers with silence (no click at the start), makes buffer A active and
  94:source\asw/sound.c ****  * buffer B inactive, clears the legacy flash fields (N6), selects input channel 1,
  95:source\asw/sound.c ****  * enables the amplifier, keeps the sample clock stopped and sets the PWM to the
  96:source\asw/sound.c ****  * silence level. The volume is not touched (default SOUND_VOLUME_MAX).
  97:source\asw/sound.c ****  *
  98:source\asw/sound.c ****  * Call once from tsk_init, before the sample timer ISR can run.
  99:source\asw/sound.c ****  *
 100:source\asw/sound.c ****  * \return RC_SUCCESS (always, nothing can fail, N9)
 101:source\asw/sound.c ****  */
 102:source\asw/sound.c **** RC_t SOUND_Init(void)
 103:source\asw/sound.c **** {
 104:source\asw/sound.c ****     /* Pre-fill both buffers with silence - no click on start */
 105:source\asw/sound.c ****     memset(SOUND__bufA, (int)SOUND_SILENCE, SOUND_BUFFER_SIZE);
 106:source\asw/sound.c ****     memset(SOUND__bufB, (int)SOUND_SILENCE, SOUND_BUFFER_SIZE);
 107:source\asw/sound.c ****  
 108:source\asw/sound.c ****     /* Dual buffer: A active, B inactive */
 109:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__bufA;
 110:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = SOUND__bufB;
 111:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND_BUFFER_SIZE;
 112:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 113:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 114:source\asw/sound.c ****  
 115:source\asw/sound.c ****     /* Flash path: cleared */
 116:source\asw/sound.c ****     SOUND__currentSong.m_song = NULL;
 117:source\asw/sound.c ****     SOUND__currentSong.m_size = 0u;
 118:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 119:source\asw/sound.c ****  
 120:source\asw/sound.c ****     /* Hardware init */
 121:source\asw/sound.c ****     SOUND_Control_Write(SOUND_CH1);
 122:source\asw/sound.c ****     SOUND_ENABLE_Write(1u);
 123:source\asw/sound.c ****     SOUND_StopPlay();
 124:source\asw/sound.c ****     SOUND_PWM_CLOCK_Start();
 125:source\asw/sound.c ****     SOUND_PWM_Start();
 126:source\asw/sound.c ****     SOUND_PWM_WriteCompare(SOUND_SILENCE);
 127:source\asw/sound.c ****  
 128:source\asw/sound.c ****     return RC_SUCCESS;
 129:source\asw/sound.c **** }
 130:source\asw/sound.c ****  
 131:source\asw/sound.c **** /**
 132:source\asw/sound.c ****  * \brief Start the sample clock; the timer ISR then calls SOUND_isr() every tick.
 133:source\asw/sound.c ****  * \return RC_SUCCESS (always, N9)
 134:source\asw/sound.c ****  */
 135:source\asw/sound.c **** RC_t SOUND_StartPlay(void)
 136:source\asw/sound.c **** {
 137:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Start();
 138:source\asw/sound.c ****  
 139:source\asw/sound.c ****     return RC_SUCCESS;
 140:source\asw/sound.c **** }
 141:source\asw/sound.c ****  
 142:source\asw/sound.c **** /**
 143:source\asw/sound.c ****  * \brief Stop the sample clock; SOUND_isr() is no longer called, the PWM holds its last value.
 144:source\asw/sound.c ****  * \return RC_SUCCESS (always, N9)
 145:source\asw/sound.c ****  */
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccqCHUPR.s 			page 4


 146:source\asw/sound.c **** RC_t SOUND_StopPlay(void)
 147:source\asw/sound.c **** {
 148:source\asw/sound.c ****     SOUND_SAMPLE_CLOCK_Stop();      /* isr_Timer_Disable() does not work, the clock is stopped inst
 149:source\asw/sound.c ****  
 150:source\asw/sound.c ****     return RC_SUCCESS;
 151:source\asw/sound.c **** }
 152:source\asw/sound.c ****  
 153:source\asw/sound.c **** /**
 154:source\asw/sound.c ****  * \brief Set a song in flash (old flash player, no longer played, N6).
 155:source\asw/sound.c ****  *
 156:source\asw/sound.c ****  * Switches the dual buffer path off: the ISR outputs nothing until the next
 157:source\asw/sound.c ****  * SOUND_FillBuffer() call. The song is only stored.
 158:source\asw/sound.c ****  *
 159:source\asw/sound.c ****  * \param uint8_t const *const song : [IN] pointer to the song data (stored only, not dereferenced)
 160:source\asw/sound.c ****  * \param uint32_t const sizeOfSong : [IN] size of the song data in bytes (stored only)
 161:source\asw/sound.c ****  * \return RC_SUCCESS (always, N9)
 162:source\asw/sound.c ****  */
 163:source\asw/sound.c **** RC_t SOUND_SetSong(uint8_t const * const song, uint32_t const sizeOfSong)
 164:source\asw/sound.c **** {
 165:source\asw/sound.c ****     /* Disable dual buffer path */
 166:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf = NULL;
 167:source\asw/sound.c ****  
 168:source\asw/sound.c ****     /* Set flash path (stored only, N6) */
 169:source\asw/sound.c ****     SOUND__currentSong.m_song = song;
 170:source\asw/sound.c ****     SOUND__currentSong.m_size = sizeOfSong;
 171:source\asw/sound.c ****     SOUND__currentSong.m_pos  = 0u;
 172:source\asw/sound.c ****  
 173:source\asw/sound.c ****     return RC_SUCCESS;
 174:source\asw/sound.c **** }
 175:source\asw/sound.c ****  
 176:source\asw/sound.c **** /**
 177:source\asw/sound.c ****  * \brief Set the output volume.
 178:source\asw/sound.c ****  *
 179:source\asw/sound.c ****  * Values above SOUND_VOLUME_MAX are limited to SOUND_VOLUME_MAX and reported (N9).
 180:source\asw/sound.c ****  * 
 181:source\asw/sound.c ****  * \param uint8_t const volume      : [IN] volume in percent, 0..SOUND_VOLUME_MAX
 182:source\asw/sound.c ****  * \return RC_SUCCESS when the volume was set as requested,
 183:source\asw/sound.c ****  *         RC_ERROR_RANGE when volume is above SOUND_VOLUME_MAX; the limited value SOUND_VOLUME_MAX
 184:source\asw/sound.c ****  */
 185:source\asw/sound.c **** RC_t SOUND_SetVolume(uint8_t const volume)
 186:source\asw/sound.c **** {
 187:source\asw/sound.c ****     RC_t    rc  = RC_SUCCESS;
 188:source\asw/sound.c ****     uint8_t vol = volume;
 189:source\asw/sound.c ****  
 190:source\asw/sound.c ****     if (vol > SOUND_VOLUME_MAX)
 191:source\asw/sound.c ****     {
 192:source\asw/sound.c ****         vol = (uint8_t)SOUND_VOLUME_MAX;
 193:source\asw/sound.c ****         rc  = RC_ERROR_RANGE;                   /* N9: the value is limited, the limited value is u
 194:source\asw/sound.c ****     }
 195:source\asw/sound.c ****  
 196:source\asw/sound.c ****     SOUND__currentSong.m_volume = vol;
 197:source\asw/sound.c ****  
 198:source\asw/sound.c ****     return rc;
 199:source\asw/sound.c **** }
 200:source\asw/sound.c ****  
 201:source\asw/sound.c **** /**
 202:source\asw/sound.c ****  * \brief Copy PCM data into the inactive buffer and announce it to the ISR (N1, N2, N5).
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccqCHUPR.s 			page 5


 203:source\asw/sound.c ****  *
 204:source\asw/sound.c ****  * The rest of the buffer is padded with SOUND_SILENCE. m_inactiveFill is set last;
 205:source\asw/sound.c ****  * only then may the ISR swap. Switches the dual buffer path on if SOUND_SetSong()
 206:source\asw/sound.c ****  * had switched it off.
 207:source\asw/sound.c ****  *
 208:source\asw/sound.c ****  * Only call while the inactive buffer is empty (after ev_BufEmpty).
 209:source\asw/sound.c ****  *
 210:source\asw/sound.c ****  * \param uint8_t const *const data : [IN] PCM bytes (unsigned 8 bit), at least size bytes, must no
 211:source\asw/sound.c ****  * \param uint16_t const size       : [IN] number of valid bytes, 1..SOUND_BUFFER_SIZE
 212:source\asw/sound.c ****  * \return RC_SUCCESS when the buffer was filled,
 213:source\asw/sound.c ****  *         RC_ERROR_NULL when data is NULL,
 214:source\asw/sound.c ****  *         RC_ERROR_ZERO when size is 0,
 215:source\asw/sound.c ****  *         RC_ERROR_OVERRUN when size is larger than SOUND_BUFFER_SIZE (nothing is changed in
 216:source\asw/sound.c ****  *         the three error cases)
 217:source\asw/sound.c ****  */
 218:source\asw/sound.c **** RC_t SOUND_FillBuffer(uint8_t const * const data, uint16_t const size)
 219:source\asw/sound.c **** {
 220:source\asw/sound.c ****     RC_t rc = RC_SUCCESS;
 221:source\asw/sound.c ****  
 222:source\asw/sound.c ****     if (data == NULL)
 223:source\asw/sound.c ****     {
 224:source\asw/sound.c ****         rc = RC_ERROR_NULL;                             /* N9: nothing to copy (before: memcpy from
 225:source\asw/sound.c ****     }
 226:source\asw/sound.c ****     else if (size == 0u)
 227:source\asw/sound.c ****     {
 228:source\asw/sound.c ****         rc = RC_ERROR_ZERO;                             /* N9 */
 229:source\asw/sound.c ****     }
 230:source\asw/sound.c ****     else if (size > SOUND_BUFFER_SIZE)
 231:source\asw/sound.c ****     {
 232:source\asw/sound.c ****         rc = RC_ERROR_OVERRUN;                          /* N9 */
 233:source\asw/sound.c ****     }
 234:source\asw/sound.c ****     else
 235:source\asw/sound.c ****     {
 236:source\asw/sound.c ****         uint8_t * dst;
 237:source\asw/sound.c ****  
 238:source\asw/sound.c ****         /* Switch to dual buffer mode if not already */
 239:source\asw/sound.c ****         if (SOUND__currentSong.m_activeBuf == NULL)
 240:source\asw/sound.c ****         {
 241:source\asw/sound.c ****             SOUND__currentSong.m_activeBuf   = SOUND__bufA;
 242:source\asw/sound.c ****             SOUND__currentSong.m_inactiveBuf = SOUND__bufB;
 243:source\asw/sound.c ****             SOUND__currentSong.m_readPos     = 0u;
 244:source\asw/sound.c ****             SOUND__currentSong.m_activeFill  = 0u;
 245:source\asw/sound.c ****         }
 246:source\asw/sound.c ****  
 247:source\asw/sound.c ****         /* Write into the inactive buffer - the ISR never touches this one (N1) */
 248:source\asw/sound.c ****         dst = SOUND__GetInactiveBuf();
 249:source\asw/sound.c ****         SOUND__currentSong.m_inactiveBuf = dst;
 250:source\asw/sound.c ****  
 251:source\asw/sound.c ****         memcpy(dst, data, size);                                              /* N5: block copy ins
 252:source\asw/sound.c ****         memset(&dst[size], (int)SOUND_SILENCE, (size_t)SOUND_BUFFER_SIZE - size);   /* pad the rema
 253:source\asw/sound.c ****  
 254:source\asw/sound.c ****         SOUND__CompilerBarrier();                       /* N2: all bytes are written before the buf
 255:source\asw/sound.c ****         SOUND__currentSong.m_inactiveFill = size;       /* last step: now the ISR may swap */
 256:source\asw/sound.c ****     }
 257:source\asw/sound.c ****  
 258:source\asw/sound.c ****     return rc;
 259:source\asw/sound.c **** }
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccqCHUPR.s 			page 6


 260:source\asw/sound.c ****  
 261:source\asw/sound.c **** /**
 262:source\asw/sound.c ****  * \brief Exchange active and inactive buffer (N1).
 263:source\asw/sound.c ****  *
 264:source\asw/sound.c ****  * The new active buffer gets the fill level of the former inactive one, the new
 265:source\asw/sound.c ****  * inactive buffer is marked empty and the read position restarts at 0.
 266:source\asw/sound.c ****  * Called from SOUND_isr() when the active buffer is finished and the inactive one
 267:source\asw/sound.c ****  * is ready, and once from tsk_reader before the timer is started (pre-fill of both
 268:source\asw/sound.c ****  * buffers, see mp3.c). Never call it from a task while the sample timer runs.
 269:source\asw/sound.c ****  *
 270:source\asw/sound.c ****  * \return RC_SUCCESS (always, N9)
 271:source\asw/sound.c ****  */
 272:source\asw/sound.c **** RC_t SOUND_SwapBuffers(void)
 273:source\asw/sound.c **** {
 274:source\asw/sound.c ****     uint8_t * tmpBuf;
 275:source\asw/sound.c ****  
 276:source\asw/sound.c ****     /* Swap the pointers and take over the fill level. In the ISR this cannot be
 277:source\asw/sound.c ****        interrupted by the reader (N1). */
 278:source\asw/sound.c ****     tmpBuf                            = SOUND__currentSong.m_activeBuf;
 279:source\asw/sound.c ****     SOUND__currentSong.m_activeBuf    = SOUND__currentSong.m_inactiveBuf;
 280:source\asw/sound.c ****     SOUND__currentSong.m_inactiveBuf  = tmpBuf;
 281:source\asw/sound.c ****     SOUND__currentSong.m_activeFill   = SOUND__currentSong.m_inactiveFill;
 282:source\asw/sound.c ****     SOUND__currentSong.m_inactiveFill = 0u;
 283:source\asw/sound.c ****     SOUND__currentSong.m_readPos      = 0u;
 284:source\asw/sound.c ****  
 285:source\asw/sound.c ****     return RC_SUCCESS;
 286:source\asw/sound.c **** }
 287:source\asw/sound.c ****  
 288:source\asw/sound.c **** /**
 289:source\asw/sound.c ****  * \brief Return the number of underrun ticks since the last call and reset the counter (N7).
 290:source\asw/sound.c ****  *
 291:source\asw/sound.c ****  * An underrun is a tick where the active buffer was finished and no new one was ready
 292:source\asw/sound.c ****  * because the reader was late. Diagnostic only: a tick that happens between reading and
 293:source\asw/sound.c ****  * clearing the counter is lost.
 294:source\asw/sound.c ****  *
 295:source\asw/sound.c ****  * \return number of ISR ticks without a new sample, 0..4294967295 (a count, not a status code, N9)
 296:source\asw/sound.c ****  */
 297:source\asw/sound.c **** uint32_t SOUND__GetAndClearUnderruns(void)
 298:source\asw/sound.c **** {
 299:source\asw/sound.c ****     uint32_t const n = SOUND__underruns;
 300:source\asw/sound.c ****  
 301:source\asw/sound.c ****     SOUND__underruns = 0u;                      /* N7: a tick between the two lines is lost */
 302:source\asw/sound.c ****     return n;
 303:source\asw/sound.c **** }
 304:source\asw/sound.c ****  
 305:source\asw/sound.c **** /*****************************************************************************/
 306:source\asw/sound.c **** /* Private helpers                                                           */
 307:source\asw/sound.c **** /*****************************************************************************/
 308:source\asw/sound.c ****  
 309:source\asw/sound.c **** /**
 310:source\asw/sound.c ****  * \brief Return the buffer that the ISR is NOT playing.
 311:source\asw/sound.c ****  * \return SOUND__bufB when A is active, otherwise SOUND__bufA
 312:source\asw/sound.c ****  */
 313:source\asw/sound.c **** static uint8_t * SOUND__GetInactiveBuf(void)
 314:source\asw/sound.c **** {
  27              		.loc 1 314 0
  28              		.cfi_startproc
