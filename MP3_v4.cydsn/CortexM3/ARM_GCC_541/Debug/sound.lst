  49:source\asw/sound.c **** /**
  50:source\asw/sound.c ****  * \brief State of the driver, shared between tsk_reader and the timer ISR (N1, N2).
  51:source\asw/sound.c ****  *
  52:source\asw/sound.c ****  * The pointers are volatile themselves ("uint8_t * volatile"), the buffer bytes
  53:source\asw/sound.c ****  * are plain data: a buffer is only touched by one side at a time (N2).
  54:source\asw/sound.c ****  */
