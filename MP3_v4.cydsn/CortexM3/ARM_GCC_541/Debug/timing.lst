  66:source\bsw\Services\analysis/timing.c **** /**
  67:source\bsw\Services\analysis/timing.c ****  * The start function for the timing analyser hardware
  68:source\bsw\Services\analysis/timing.c ****  * Only called once to avoid problems with multiple timer objects
  69:source\bsw\Services\analysis/timing.c ****  **/
  70:source\bsw\Services\analysis/timing.c **** RC_t TA_init()
  71:source\bsw\Services\analysis/timing.c **** {
  72:source\bsw\Services\analysis/timing.c ****     
  73:source\bsw\Services\analysis/timing.c ****     //Init the DWT COunter
  74:source\bsw\Services\analysis/timing.c ****     CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk; //Activate the trace unit
  75:source\bsw\Services\analysis/timing.c ****     DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;            //Activate the cycle counter
  76:source\bsw\Services\analysis/timing.c ****     DWT->CYCCNT = 0;                                //Set the start value to 0
  77:source\bsw\Services\analysis/timing.c ****  
  78:source\bsw\Services\analysis/timing.c ****     //Init the Systick Counter
  79:source\bsw\Services\analysis/timing.c ****     CySysTickInit();
  80:source\bsw\Services\analysis/timing.c ****     CySysTickSetCallback(0, TA_systick_isr);           //Set ISR for Systick
  81:source\bsw\Services\analysis/timing.c ****     CySysTickSetReload(TA_SYSTICK_1MS_RELOAD);   //1ms cycle Time
  82:source\bsw\Services\analysis/timing.c ****     CySysTickEnable();
  83:source\bsw\Services\analysis/timing.c ****     
  84:source\bsw\Services\analysis/timing.c ****     return RC_SUCCESS;
  85:source\bsw\Services\analysis/timing.c **** }
