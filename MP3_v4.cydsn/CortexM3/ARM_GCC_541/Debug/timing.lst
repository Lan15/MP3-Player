 155:source\bsw\Services\analysis/timing.c **** /**
 156:source\bsw\Services\analysis/timing.c ****  * The stop function for the timing analyser, will stop the measurement
 157:source\bsw\Services\analysis/timing.c ****  * \param TA_t *const me                : [IN/OUT] The timing object
 158:source\bsw\Services\analysis/timing.c ****  */
 159:source\bsw\Services\analysis/timing.c **** RC_t TA_stop(TA_t *const me)
 160:source\bsw\Services\analysis/timing.c **** {
 161:source\bsw\Services\analysis/timing.c ****     
 162:source\bsw\Services\analysis/timing.c ****     if (me->m_state == TA_ISSTOPPED)
 163:source\bsw\Services\analysis/timing.c ****     {
 164:source\bsw\Services\analysis/timing.c ****         return RC_ERROR_INVALID_STATE;
 165:source\bsw\Services\analysis/timing.c ****     }
 166:source\bsw\Services\analysis/timing.c ****     
 167:source\bsw\Services\analysis/timing.c ****     switch (me->m_mode)
 168:source\bsw\Services\analysis/timing.c ****     {
 169:source\bsw\Services\analysis/timing.c ****         case TA_DWT :
 170:source\bsw\Services\analysis/timing.c ****             me->m_elapsedTime += (DWT->CYCCNT - me->m_startTime);
 171:source\bsw\Services\analysis/timing.c ****             break;
 172:source\bsw\Services\analysis/timing.c ****         
 173:source\bsw\Services\analysis/timing.c ****         case TA_SYSTICK : 
 174:source\bsw\Services\analysis/timing.c ****             me->m_elapsedTime += (TA_systick_count - me->m_startTime);
 175:source\bsw\Services\analysis/timing.c ****             break;
 176:source\bsw\Services\analysis/timing.c ****         
 177:source\bsw\Services\analysis/timing.c ****         case TA_NONE : 
 178:source\bsw\Services\analysis/timing.c ****             //Nothing to be done
 179:source\bsw\Services\analysis/timing.c ****             break;
 180:source\bsw\Services\analysis/timing.c ****         
 181:source\bsw\Services\analysis/timing.c ****         default: 
 182:source\bsw\Services\analysis/timing.c ****             return RC_ERROR_INVALID;
 183:source\bsw\Services\analysis/timing.c ****     }
 184:source\bsw\Services\analysis/timing.c ****     
 185:source\bsw\Services\analysis/timing.c ****     //Stop the pin toggle if active
 186:source\bsw\Services\analysis/timing.c ****     if (0 != me->p_pinWrite)
 187:source\bsw\Services\analysis/timing.c ****     {
 188:source\bsw\Services\analysis/timing.c ****         me->p_pinWrite(0);
 189:source\bsw\Services\analysis/timing.c ****     }
 190:source\bsw\Services\analysis/timing.c ****         
 191:source\bsw\Services\analysis/timing.c ****     
 192:source\bsw\Services\analysis/timing.c ****     me->m_state = TA_ISSTOPPED;
 193:source\bsw\Services\analysis/timing.c ****     
