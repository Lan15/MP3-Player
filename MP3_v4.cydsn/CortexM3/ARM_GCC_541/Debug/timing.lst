 135:source\bsw\Services\analysis/timing.c ****         
 136:source\bsw\Services\analysis/timing.c ****         case TA_NONE : 
 137:source\bsw\Services\analysis/timing.c ****             //Nothing to be done
 138:source\bsw\Services\analysis/timing.c ****             break;
 139:source\bsw\Services\analysis/timing.c ****         
 140:source\bsw\Services\analysis/timing.c ****         default: 
 141:source\bsw\Services\analysis/timing.c ****             return RC_ERROR_INVALID;
 142:source\bsw\Services\analysis/timing.c ****     }
 143:source\bsw\Services\analysis/timing.c ****     
 144:source\bsw\Services\analysis/timing.c ****     //Start the pin toggle if active
 145:source\bsw\Services\analysis/timing.c ****     if (0 != me->p_pinWrite)
