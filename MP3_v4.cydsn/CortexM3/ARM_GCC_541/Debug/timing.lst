 276:source\bsw\Services\analysis/timing.c ****     }
 277:source\bsw\Services\analysis/timing.c **** 
 278:source\bsw\Services\analysis/timing.c ****     uint64_t nanoseconds = 0;
 279:source\bsw\Services\analysis/timing.c ****     uint64_t nanoseconds_whole = 0;
 280:source\bsw\Services\analysis/timing.c ****     uint64_t nanoseconds_fraction = 0;
 281:source\bsw\Services\analysis/timing.c ****     
 282:source\bsw\Services\analysis/timing.c ****     switch (me->m_mode)
 283:source\bsw\Services\analysis/timing.c ****     {
 284:source\bsw\Services\analysis/timing.c ****         case TA_DWT :
