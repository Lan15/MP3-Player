 271:source\bsw\Services\analysis/timing.c **** RC_t TA_print(TA_t const * const me)
 272:source\bsw\Services\analysis/timing.c **** {
 273:source\bsw\Services\analysis/timing.c ****     if (me->m_state == TA_ISRUNNING)
 274:source\bsw\Services\analysis/timing.c ****     {
