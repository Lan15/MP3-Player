 290:source\bsw\Services\analysis/timing.c ****         
 291:source\bsw\Services\analysis/timing.c ****         case TA_SYSTICK : 
 292:source\bsw\Services\analysis/timing.c ****             LOG_D("TA %s (SysTick) -> %u ms", me->m_name, me->m_elapsedTime);
 293:source\bsw\Services\analysis/timing.c ****             
