  73:source\asw/wav_parser.c **** #define WAV__FMT_EXT_MIN_SIZE    (26u)          /**< fmt size needed to read the 2 byte sub-format 
  74:source\asw/wav_parser.c **** #define WAV__FMT_MAX_READ        (40u)          /**< largest fmt body that is looked at (16 + 24)  
  75:source\asw/wav_parser.c **** /** \} */
  76:source\asw/wav_parser.c **** 
  77:source\asw/wav_parser.c **** /** \name Read window and scan limits (N1)
