 490:source\asw/wav_parser.c **** /**
 491:source\asw/wav_parser.c ****  * \brief Parse the header of an open emFile WAV file.
 492:source\asw/wav_parser.c ****  *
 493:source\asw/wav_parser.c ****  * Checks the pointers, then lets WAV__ParseChunks() do the work. After a successful
 494:source\asw/wav_parser.c ****  * call the file position is on the first PCM byte (N6). The function seeks to
 495:source\asw/wav_parser.c ****  * offset 0 itself. Header bytes come through one read window (N1).
 496:source\asw/wav_parser.c ****  *
 497:source\asw/wav_parser.c ****  * Not re-entrant (static read window), call from tsk_reader only (N8).
 498:source\asw/wav_parser.c ****  *
 499:source\asw/wav_parser.c ****  * \param FS_FILE *const pFile         : [IN]  open emFile handle (mode "r"), not NULL
 500:source\asw/wav_parser.c ****  * \param WAVFile *const wav           : [OUT] structure to fill, not NULL; header fields and data_
 501:source\asw/wav_parser.c ****  *                                     (limited to the bytes left in the file, N5) are valid on RC_
 502:source\asw/wav_parser.c ****  * \return RC_SUCCESS when the header is valid, FS_FTell() gives the offset of the
 503:source\asw/wav_parser.c ****  *         first PCM byte,
 504:source\asw/wav_parser.c ****  *         RC_ERROR_NULL when pFile or wav is NULL (nothing is read, nothing is logged),
 505:source\asw/wav_parser.c ****  *         RC_ERROR_READ_FAILS when a seek or read failed (reason in the log),
 506:source\asw/wav_parser.c ****  *         RC_ERROR_INVALID when the file is not RIFF/WAVE, the fmt chunk is too small,
 507:source\asw/wav_parser.c ****  *         data comes before fmt or there is no data chunk (reason in the log),
 508:source\asw/wav_parser.c ****  *         RC_ERROR when the file is valid but not playable: not PCM, not 1/2 channels,
 509:source\asw/wav_parser.c ****  *         not 8/16/24 bit, block_align contradicts channels * bits, or not 22050/44100 Hz
 510:source\asw/wav_parser.c ****  *         (reason in the log)
 511:source\asw/wav_parser.c ****  */
 512:source\asw/wav_parser.c **** RC_t WAV_ParseHeader(FS_FILE * const pFile, WAVFile * const wav)
