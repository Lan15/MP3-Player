  47:source\asw/wav_parser.c **** #define WAV__OFF_FORMAT          (8u)           /**< "WAVE" tag                        */
  48:source\asw/wav_parser.c **** #define WAV__RIFF_HDR_SIZE       (12u)          /**< size of the RIFF header = offset of the first 
  49:source\asw/wav_parser.c **** /** \} */
  50:source\asw/wav_parser.c **** 
