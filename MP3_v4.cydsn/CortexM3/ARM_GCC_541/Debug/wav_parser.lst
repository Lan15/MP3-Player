   1:source\asw/wav_parser.c **** /**
   2:source\asw/wav_parser.c **** * \file    wav_parser.c
   3:source\asw/wav_parser.c **** * \author  V S Agilan
   4:source\asw/wav_parser.c **** * \date    30.04.26
   5:source\asw/wav_parser.c **** *
   6:source\asw/wav_parser.c **** * \brief   WAV file header parser (emFile) with RIFF chunk walker
   7:source\asw/wav_parser.c **** *
   8:source\asw/wav_parser.c **** * \details
   9:source\asw/wav_parser.c **** * Reads the RIFF/WAVE header of an open emFile file and leaves the file
  10:source\asw/wav_parser.c **** * position on the first PCM byte.
  11:source\asw/wav_parser.c **** *
  12:source\asw/wav_parser.c **** * The chunk list is walked instead of assuming that 'data' sits at byte 36:
  13:source\asw/wav_parser.c **** *   RIFF header (12) -> chunk -> chunk -> ... -> 'data'
  14:source\asw/wav_parser.c **** * Chunks other than 'fmt ' and 'data' (LIST, INFO, JUNK, ...) are skipped.
  15:source\asw/wav_parser.c **** *
  16:source\asw/wav_parser.c **** * Header bytes are fetched through one 256 byte read window (N1), so a
  17:source\asw/wav_parser.c **** * typical file costs a single SD sector read instead of one read per field.
  18:source\asw/wav_parser.c **** *
  19:source\asw/wav_parser.c **** * Design notes N1..N11 are collected at the end of this file.
  20:source\asw/wav_parser.c **** */
  21:source\asw/wav_parser.c **** 
  22:source\asw/wav_parser.c **** /*****************************************************************************/
  23:source\asw/wav_parser.c **** /* Include files                                                             */
  24:source\asw/wav_parser.c **** /*****************************************************************************/
  25:source\asw/wav_parser.c **** 
  26:source\asw/wav_parser.c **** #include "wav_parser.h"
  27:source\asw/wav_parser.c **** #include "log.h"            /* LOG_W(), LOG_E(), LOG_I() (N11) */
  28:source\asw/wav_parser.c **** #include <string.h>         /* memcpy() */
  29:source\asw/wav_parser.c **** 
  30:source\asw/wav_parser.c **** /*****************************************************************************/
  31:source\asw/wav_parser.c **** /* Local pre-processor symbols/macros                                        */
