ARM GAS  C:\Users\agila\AppData\Local\Temp\ccqScRUS.s 			page 3


  88:source\bsw\Services\message/ringbuffer.c ****  * \param RB_data_t const *const data   : [IN]     element which will be stored
  89:source\bsw\Services\message/ringbuffer.c ****  * \return RC_ERROR_BUFFER_FULL in case no empty space is available anymore
  90:source\bsw\Services\message/ringbuffer.c ****  */
  91:source\bsw\Services\message/ringbuffer.c **** RC_t RB_put(RB_ringbuffer_t* const me, RB_data_t const *const data)
  92:source\bsw\Services\message/ringbuffer.c **** {
  93:source\bsw\Services\message/ringbuffer.c ****     
  94:source\bsw\Services\message/ringbuffer.c ****     RC_t ret = RC_SUCCESS;
  95:source\bsw\Services\message/ringbuffer.c ****     
  96:source\bsw\Services\message/ringbuffer.c ****     RB_enterCriticalRegion();
  97:source\bsw\Services\message/ringbuffer.c ****     
  98:source\bsw\Services\message/ringbuffer.c ****     RB_size_t fillLevel = 0;
  99:source\bsw\Services\message/ringbuffer.c ****     if ( (RC_SUCCESS == RB_getFillLevel(me, &fillLevel)) && (fillLevel < me->m_size) )
 100:source\bsw\Services\message/ringbuffer.c ****     {
 101:source\bsw\Services\message/ringbuffer.c ****         me->m_pBuffer[me->m_writeIndex++] = *data;
 102:source\bsw\Services\message/ringbuffer.c ****         me->m_writeIndex %= me->m_size;
 103:source\bsw\Services\message/ringbuffer.c ****         me->m_countPut++;
 104:source\bsw\Services\message/ringbuffer.c ****     }
 105:source\bsw\Services\message/ringbuffer.c ****     else
 106:source\bsw\Services\message/ringbuffer.c ****     {
 107:source\bsw\Services\message/ringbuffer.c ****         ret =  RC_ERROR_BUFFER_FULL;
 108:source\bsw\Services\message/ringbuffer.c ****     }
 109:source\bsw\Services\message/ringbuffer.c ****     
 110:source\bsw\Services\message/ringbuffer.c ****     RB_leaveCriticalRegion();
 111:source\bsw\Services\message/ringbuffer.c ****     
 112:source\bsw\Services\message/ringbuffer.c ****     return ret;
 113:source\bsw\Services\message/ringbuffer.c **** }
 114:source\bsw\Services\message/ringbuffer.c **** 
 115:source\bsw\Services\message/ringbuffer.c **** /**
 116:source\bsw\Services\message/ringbuffer.c ****  * Read function for ringbuffer
 117:source\bsw\Services\message/ringbuffer.c ****  * \param RB_ringbuffer_t* const me     : [IN/OUT] pointer to the ringbuffer object
 118:source\bsw\Services\message/ringbuffer.c ****  * \param RB_data_t* data               : [OUT]    pointer to the element read from the buffer
 119:source\bsw\Services\message/ringbuffer.c ****  * \return RC_ERROR_BUFFER_EMTPY if buffer was empty
 120:source\bsw\Services\message/ringbuffer.c ****  */
 121:source\bsw\Services\message/ringbuffer.c **** RC_t RB_get(RB_ringbuffer_t* const me, RB_data_t* const data)
 122:source\bsw\Services\message/ringbuffer.c **** {
 123:source\bsw\Services\message/ringbuffer.c ****     RC_t ret = RC_SUCCESS;
 124:source\bsw\Services\message/ringbuffer.c ****     
 125:source\bsw\Services\message/ringbuffer.c ****     RB_enterCriticalRegion();
 126:source\bsw\Services\message/ringbuffer.c ****     
 127:source\bsw\Services\message/ringbuffer.c ****     RB_size_t fillLevel = 0;
 128:source\bsw\Services\message/ringbuffer.c ****     if ( (RC_SUCCESS == RB_getFillLevel(me, &fillLevel)) && (fillLevel > 0) )
 129:source\bsw\Services\message/ringbuffer.c ****     {
 130:source\bsw\Services\message/ringbuffer.c ****         *data = me->m_pBuffer[me->m_readIndex++];
 131:source\bsw\Services\message/ringbuffer.c ****         me->m_readIndex %= me->m_size;
 132:source\bsw\Services\message/ringbuffer.c ****         me->m_countGet++;
 133:source\bsw\Services\message/ringbuffer.c ****         
 134:source\bsw\Services\message/ringbuffer.c ****     }
 135:source\bsw\Services\message/ringbuffer.c ****     else
 136:source\bsw\Services\message/ringbuffer.c ****     {
 137:source\bsw\Services\message/ringbuffer.c ****         ret =  RC_ERROR_BUFFER_EMTPY;
 138:source\bsw\Services\message/ringbuffer.c ****     }
 139:source\bsw\Services\message/ringbuffer.c ****     
 140:source\bsw\Services\message/ringbuffer.c ****     RB_leaveCriticalRegion();
 141:source\bsw\Services\message/ringbuffer.c ****     
 142:source\bsw\Services\message/ringbuffer.c ****     return ret;    
 143:source\bsw\Services\message/ringbuffer.c ****     
 144:source\bsw\Services\message/ringbuffer.c **** }
