  55:source\bsw\Services\message/ringbuffer.c **** /**
  56:source\bsw\Services\message/ringbuffer.c ****  * Init function for ringbuffer. Use pBuffer paramater to allocate memory directly or via heap.
  57:source\bsw\Services\message/ringbuffer.c ****  * \param ringbuffer_t* const me    : [OUT] pointer to the ringbuffer object
  58:source\bsw\Services\message/ringbuffer.c ****  * \param RB_size_t size            : [IN]  size of the ringbuffer in byte. 
  59:source\bsw\Services\message/ringbuffer.c ****  * \param RB_data_t* pBuffer        : [IN]  pointer to the buffer. If set to 0, malloc will be used
  60:source\bsw\Services\message/ringbuffer.c ****  * \return RC_ERRORMEMORY in case memory allocation failed 
  61:source\bsw\Services\message/ringbuffer.c ****  */
  62:source\bsw\Services\message/ringbuffer.c **** RC_t RB_init(RB_ringbuffer_t* const me, RB_size_t size, RB_data_t* pBuffer)
  63:source\bsw\Services\message/ringbuffer.c **** {
  64:source\bsw\Services\message/ringbuffer.c ****     me->m_size = size;
  65:source\bsw\Services\message/ringbuffer.c **** 
  66:source\bsw\Services\message/ringbuffer.c ****     if (pBuffer != 0)
  67:source\bsw\Services\message/ringbuffer.c ****     {
  68:source\bsw\Services\message/ringbuffer.c ****         //Some buffer is provided from the outside
  69:source\bsw\Services\message/ringbuffer.c ****         //It is the user's responsibility to ensure that size and pBuffer parameter are in sync
  70:source\bsw\Services\message/ringbuffer.c ****         me->m_bufOnHeap = FALSE;
  71:source\bsw\Services\message/ringbuffer.c ****         me->m_pBuffer = pBuffer;
  72:source\bsw\Services\message/ringbuffer.c ****     }
  73:source\bsw\Services\message/ringbuffer.c ****     else
  74:source\bsw\Services\message/ringbuffer.c ****     {
  75:source\bsw\Services\message/ringbuffer.c ****         //No buffer is provided, we use the heap
  76:source\bsw\Services\message/ringbuffer.c ****         me->m_bufOnHeap = TRUE;
  77:source\bsw\Services\message/ringbuffer.c ****         me->m_pBuffer = (RB_data_t*)malloc(me->m_size * sizeof(RB_data_t));
  78:source\bsw\Services\message/ringbuffer.c ****         
  79:source\bsw\Services\message/ringbuffer.c ****         if (0 == me->m_pBuffer) return RC_ERROR_MEMORY;
  80:source\bsw\Services\message/ringbuffer.c ****     }
  81:source\bsw\Services\message/ringbuffer.c ****     
  82:source\bsw\Services\message/ringbuffer.c ****     return RB_clear(me);
  83:source\bsw\Services\message/ringbuffer.c **** }
  84:source\bsw\Services\message/ringbuffer.c **** 
