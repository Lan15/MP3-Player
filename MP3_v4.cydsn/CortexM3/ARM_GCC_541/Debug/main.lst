 188:source\asw/main.c **** /**
 189:source\asw/main.c ****  * \brief Program entry point: enable the interrupts, start the system tick and the OS.
 190:source\asw/main.c ****  *
 191:source\asw/main.c ****  * Sets the system tick period to 1 ms (derived from the bus clock BCLK__BUS_CLK__HZ),
 192:source\asw/main.c ****  * enables its interrupt and starts it, then hands over to the operating system.
 193:source\asw/main.c ****  * StartOS() does not return; the endless loop below it is a safety net only (N7).
 194:source\asw/main.c ****  * The first task that runs is tsk_init.
 195:source\asw/main.c ****  *
 196:source\asw/main.c ****  * \return does not return (int by the C standard)
 197:source\asw/main.c ****  */
 198:source\asw/main.c **** int main()
 199:source\asw/main.c **** {
  28              		.loc 1 199 0
  29              		.cfi_startproc
