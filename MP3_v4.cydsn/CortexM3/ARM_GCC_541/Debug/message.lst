 124:source\bsw\Services\message/message.c **** RC_t MSG_sendMessage(MSG_messagebox_t *const me, void const* const pData, uint16_t const size, MSG_
 125:source\bsw\Services\message/message.c **** {
 126:source\bsw\Services\message/message.c ****     
 127:source\bsw\Services\message/message.c ****     RC_t res = RC_SUCCESS;
 128:source\bsw\Services\message/message.c ****     
 129:source\bsw\Services\message/message.c **** #ifdef MSG_TIME_ANALYSIS
 130:source\bsw\Services\message/message.c ****     MSG_startMeasurement();
 131:source\bsw\Services\message/message.c **** #endif    
 132:source\bsw\Services\message/message.c ****     
 133:source\bsw\Services\message/message.c ****     if (MSG_getFillLevel(me) <  me->m_size)
 134:source\bsw\Services\message/message.c ****     {
 135:source\bsw\Services\message/message.c ****         
 136:source\bsw\Services\message/message.c ****         void* pBuffer = 0;
 137:source\bsw\Services\message/message.c ****         
 138:source\bsw\Services\message/message.c ****         //Critical section starts
 139:source\bsw\Services\message/message.c ****         
 140:source\bsw\Services\message/message.c ****         if (me->m_ressource != 0) GetResource(me->m_ressource);
 141:source\bsw\Services\message/message.c ****         MSG_DI;
 142:source\bsw\Services\message/message.c ****         
 143:source\bsw\Services\message/message.c ****         //Clear the old message buffer and reallocate memory unless we can reuse it (same size)
