ARM GAS  C:\Users\agila\AppData\Local\Temp\cc3vcoua.s 			page 4


 145:source\bsw\Services\message/message.c ****         {
 146:source\bsw\Services\message/message.c ****             if (0 != me->m_content[me->m_writeIdx].m_size)
 147:source\bsw\Services\message/message.c ****             {
 148:source\bsw\Services\message/message.c ****                 //Previous memory does not fit, let's clear it
 149:source\bsw\Services\message/message.c ****                 free(me->m_content[me->m_writeIdx].mp_memory);
 150:source\bsw\Services\message/message.c ****                 
 151:source\bsw\Services\message/message.c ****                 //And set it to size 0, as no payload may be required
 152:source\bsw\Services\message/message.c ****                 //Will happen later as well, but just to be on the safe side....
 153:source\bsw\Services\message/message.c ****                 me->m_content[me->m_writeIdx].mp_memory = 0;
 154:source\bsw\Services\message/message.c ****                 me->m_content[me->m_writeIdx].m_size = 0;
 155:source\bsw\Services\message/message.c ****             }        
 156:source\bsw\Services\message/message.c **** 
 157:source\bsw\Services\message/message.c ****             //Allocate memory for transmission, if needed
 158:source\bsw\Services\message/message.c ****             if (0 != pData && 0 != size)
 159:source\bsw\Services\message/message.c ****             {
 160:source\bsw\Services\message/message.c ****                 pBuffer = malloc(size); 
 161:source\bsw\Services\message/message.c ****                 res = MSG_checkAllocation(pBuffer);
 162:source\bsw\Services\message/message.c ****                 if (RC_SUCCESS != res) 
 163:source\bsw\Services\message/message.c ****                 {
 164:source\bsw\Services\message/message.c ****                     pBuffer = 0;
 165:source\bsw\Services\message/message.c ****                 }
 166:source\bsw\Services\message/message.c ****             }
 167:source\bsw\Services\message/message.c ****         }
 168:source\bsw\Services\message/message.c ****         else
 169:source\bsw\Services\message/message.c ****         {   
 170:source\bsw\Services\message/message.c ****             //Existing buffer will do
 171:source\bsw\Services\message/message.c ****             pBuffer = me->m_content[me->m_writeIdx].mp_memory;
 172:source\bsw\Services\message/message.c ****         }
 173:source\bsw\Services\message/message.c **** 
 174:source\bsw\Services\message/message.c ****         //We now have a valid buffer, let's copy the data, at least if we have some
 175:source\bsw\Services\message/message.c ****         if (0 != pData && 0 != size)
 176:source\bsw\Services\message/message.c ****         {
 177:source\bsw\Services\message/message.c ****             //Deep copy of the data into the allocated memory
 178:source\bsw\Services\message/message.c ****             for (uint16_t i = 0; i < size; i++)
 179:source\bsw\Services\message/message.c ****             {
 180:source\bsw\Services\message/message.c ****                 ((uint8*)pBuffer)[i] = ((uint8*)pData)[i]; 
 181:source\bsw\Services\message/message.c ****             }
 182:source\bsw\Services\message/message.c ****         } 
 183:source\bsw\Services\message/message.c ****         
 184:source\bsw\Services\message/message.c ****         //Copy the content into the message
 185:source\bsw\Services\message/message.c ****         me->m_content[me->m_writeIdx].m_size = size;     
 186:source\bsw\Services\message/message.c ****         me->m_content[me->m_writeIdx].m_msgId = id;     
 187:source\bsw\Services\message/message.c ****         me->m_content[me->m_writeIdx].mp_memory = pBuffer;  
 188:source\bsw\Services\message/message.c **** 
 189:source\bsw\Services\message/message.c ****         me->m_writeCount++;  
 190:source\bsw\Services\message/message.c ****         me->m_writeIdx++;                  
 191:source\bsw\Services\message/message.c ****         me->m_writeIdx %= me->m_size;     
 192:source\bsw\Services\message/message.c ****         
 193:source\bsw\Services\message/message.c ****         MSG_EI;
 194:source\bsw\Services\message/message.c ****         if (me->m_ressource != 0) ReleaseResource(me->m_ressource);
 195:source\bsw\Services\message/message.c ****         
 196:source\bsw\Services\message/message.c ****         SetEvent(me->m_task, me->m_ev);    
 197:source\bsw\Services\message/message.c ****     }
 198:source\bsw\Services\message/message.c ****     else
 199:source\bsw\Services\message/message.c ****     {
 200:source\bsw\Services\message/message.c ****         LOG_E("MSG MSG_sendMessage buffer full");
 201:source\bsw\Services\message/message.c ****         CEH_report(&CEH, CEH_URTE_MESSAGE_BUFFERFULL, 0);
