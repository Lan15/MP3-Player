 548:source\bsw\tft/tft.c **** void TFT_fastVLine(int16_t x, int16_t y, int16_t h, TFT_color_t color) {
 549:source\bsw\tft/tft.c **** 
 550:source\bsw\tft/tft.c ****   // Rudimentary clipping
 551:source\bsw\tft/tft.c ****   if((x >= _width) || (y >= _height)) return;
 552:source\bsw\tft/tft.c ****   if((y+h-1) >= _height) h = _height-y;
 553:source\bsw\tft/tft.c ****   setAddrWindow(x, y, x, y+h-1);
 554:source\bsw\tft/tft.c **** 
 555:source\bsw\tft/tft.c ****   uint8_t hi = color >> 8, lo = color;
 556:source\bsw\tft/tft.c ****     
 557:source\bsw\tft/tft.c ****   TFT_DC_HIGH;
 558:source\bsw\tft/tft.c ****   while (h--) {
 559:source\bsw\tft/tft.c ****     TFT_write_stream(hi);
 560:source\bsw\tft/tft.c ****     TFT_write_stream(lo);
 561:source\bsw\tft/tft.c ****   }
 562:source\bsw\tft/tft.c **** }
 563:source\bsw\tft/tft.c **** 
 564:source\bsw\tft/tft.c **** void TFT_fastHLine(int16_t x, int16_t y, int16_t w,  TFT_color_t color) {
 565:source\bsw\tft/tft.c **** 
 566:source\bsw\tft/tft.c ****     // Rudimentary clipping
 567:source\bsw\tft/tft.c ****     if((x >= _width) || (y >= _height)) return;
 568:source\bsw\tft/tft.c ****     if((x+w-1) >= _width)  w = _width-x;
 569:source\bsw\tft/tft.c ****     setAddrWindow(x, y, x+w-1, y);
 570:source\bsw\tft/tft.c **** 
 571:source\bsw\tft/tft.c ****     uint8_t hi = color >> 8, lo = color;
 572:source\bsw\tft/tft.c **** 
 573:source\bsw\tft/tft.c ****     TFT_DC_HIGH;
 574:source\bsw\tft/tft.c **** 
 575:source\bsw\tft/tft.c ****     while (w--) {
 576:source\bsw\tft/tft.c ****         TFT_write_stream(hi);
 577:source\bsw\tft/tft.c ****         TFT_write_stream(lo);
 578:source\bsw\tft/tft.c ****     }
 579:source\bsw\tft/tft.c **** }
 580:source\bsw\tft/tft.c **** 
 581:source\bsw\tft/tft.c **** // Bresenham's algorithm - thx wikpedia
 582:source\bsw\tft/tft.c **** void TFT_writeLine(int16_t x0, int16_t y0, int16_t x1, int16_t y1,  TFT_color_t color) {
 583:source\bsw\tft/tft.c ****     int16_t steep = _abs(y1 - y0) > _abs(x1 - x0);
 584:source\bsw\tft/tft.c ****     if (steep) {
 585:source\bsw\tft/tft.c ****         _swap_int16_t(x0, y0);
 586:source\bsw\tft/tft.c ****         _swap_int16_t(x1, y1);
 587:source\bsw\tft/tft.c ****     }
 588:source\bsw\tft/tft.c **** 
 589:source\bsw\tft/tft.c ****     if (x0 > x1) {
 590:source\bsw\tft/tft.c ****         _swap_int16_t(x0, x1);
 591:source\bsw\tft/tft.c ****         _swap_int16_t(y0, y1);
 592:source\bsw\tft/tft.c ****     }
 593:source\bsw\tft/tft.c **** 
 594:source\bsw\tft/tft.c ****     int16_t dx, dy;
 595:source\bsw\tft/tft.c ****     dx = x1 - x0;
 596:source\bsw\tft/tft.c ****     dy = _abs(y1 - y0);
 597:source\bsw\tft/tft.c **** 
 598:source\bsw\tft/tft.c ****     int16_t err = dx / 2;
 599:source\bsw\tft/tft.c ****     int16_t ystep;
 600:source\bsw\tft/tft.c **** 
 601:source\bsw\tft/tft.c ****     if (y0 < y1) {
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccvGdjpi.s 			page 42


 602:source\bsw\tft/tft.c ****         ystep = 1;
 603:source\bsw\tft/tft.c ****     } else {
 604:source\bsw\tft/tft.c ****         ystep = -1;
 605:source\bsw\tft/tft.c ****     }
 606:source\bsw\tft/tft.c **** 
 607:source\bsw\tft/tft.c ****     for (; x0<=x1; x0++) {
 608:source\bsw\tft/tft.c ****         if (steep) {
 609:source\bsw\tft/tft.c ****             TFT_drawPixel(y0, x0, color);
 610:source\bsw\tft/tft.c ****         } else {
 611:source\bsw\tft/tft.c ****             TFT_drawPixel(x0, y0, color);
 612:source\bsw\tft/tft.c ****         }
 613:source\bsw\tft/tft.c ****         err -= dy;
 614:source\bsw\tft/tft.c ****         if (err < 0) {
 615:source\bsw\tft/tft.c ****             y0 += ystep;
 616:source\bsw\tft/tft.c ****             err += dx;
 617:source\bsw\tft/tft.c ****         }
