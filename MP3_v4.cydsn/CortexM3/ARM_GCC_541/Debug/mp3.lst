 251:source\asw/mp3.c **** /**
 252:source\asw/mp3.c ****  * \brief Initialise the player: scan the SD card, set the start volume, draw the TFT header.
 253:source\asw/mp3.c ****  *
 254:source\asw/mp3.c ****  * Resets player and reader to STOPPED / IDLE with the first song selected, calls
 255:source\asw/mp3.c ****  * FS_Init() and scans the card from the root (MP3__scanSD, N6). A scan problem
 256:source\asw/mp3.c ****  * sets the error flag (N8). Writes "No WAV files found" once if nothing was found.
 257:source\asw/mp3.c ****  *
 258:source\asw/mp3.c ****  * Call once from tsk_init after TFT_Init() and SOUND_Init().
 259:source\asw/mp3.c ****  *
ARM GAS  C:\Users\agila\AppData\Local\Temp\ccrhcaQd.s 			page 6


 260:source\asw/mp3.c ****  * \return RC_SUCCESS when the card was scanned (also with 0 songs found),
 261:source\asw/mp3.c ****  *         RC_ERROR_OPEN when a folder could not be opened, the list may be incomplete
 262:source\asw/mp3.c ****  *         (UART line written, error shown on the TFT)
 263:source\asw/mp3.c ****  */
 264:source\asw/mp3.c **** RC_t MP3_Init(void)
 265:source\asw/mp3.c **** {
 266:source\asw/mp3.c ****     RC_t rc;
 267:source\asw/mp3.c ****  
 268:source\asw/mp3.c ****     MP3__player.m_state       = MP3STATE_ISSTOPPED;
 269:source\asw/mp3.c ****     MP3__player.m_volume      = MP3__MAXVOLUME;
