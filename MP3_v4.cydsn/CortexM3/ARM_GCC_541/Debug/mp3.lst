 854:source\asw/mp3.c ****     uint32_t maxBytes         = (uint32_t)SOUND_BUFFER_SIZE * inBytes;
 855:source\asw/mp3.c ****     uint32_t toRead;
 856:source\asw/mp3.c ****     U32      bytesRead;
 857:source\asw/mp3.c ****     uint32_t total;
 858:source\asw/mp3.c ****     uint16_t samples;
 859:source\asw/mp3.c **** 
 860:source\asw/mp3.c ****     /* INC 6A: never read more than the buffer can hold */
 861:source\asw/mp3.c ****     if (maxBytes > MP3__MAX_READ)
 862:source\asw/mp3.c ****     {
